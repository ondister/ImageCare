<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ImageCare.UI.Avalonia.ViewModels"
             xmlns:localization="clr-namespace:ImageCare.UI.Avalonia.Localization"
             mc:Ignorable="d"
             x:DataType="viewModels:SettingsViewModel"
             x:Class="ImageCare.UI.Avalonia.Views.SettingsView">

    <TabControl Margin="{DynamicResource MarginAll.Medium}">
        <TabItem Header="{localization:Loc Settings_General}">
            <StackPanel Margin="{DynamicResource MarginAll.Medium}"
                        Spacing="8">
                <TextBlock Text="{localization:Loc Settings_InterfaceLanguage}"
                           FontWeight="Bold"
                           FontSize="{DynamicResource Font.Size.SectionHeader}" />
                <ComboBox ItemsSource="{Binding AvailableLanguages}"
                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                          MinWidth="240"
                          HorizontalAlignment="Left">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="localization:LanguageOption">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{localization:Loc Settings_LanguageDescription}"
                           Opacity="0.7"
                           TextWrapping="Wrap" />
            </StackPanel>
        </TabItem>

        <TabItem Header="{localization:Loc Settings_FileAssociations}">
            <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="0" VerticalAlignment="Top">
                <Border Grid.Row="0"
                        Background="{DynamicResource ThemeBackgroundBrush}"
                        CornerRadius="{DynamicResource BorderRadius.Small}"
                        Padding="{DynamicResource Padding.Medium}"
                        Margin="{DynamicResource MarginBottom.Medium}">
                    <StackPanel>
                        <TextBlock Text="{localization:Loc Settings_AddNewAssociation}"
                                   FontWeight="Bold"
                                   FontSize="{DynamicResource Font.Size.SectionHeader}"
                                   Margin="{DynamicResource MarginBottom.Medium}" />

                        <Grid ColumnDefinitions="*,*,Auto"
                              Margin="{DynamicResource MarginVertical.Small}">
                            <TextBox Grid.Column="0"
                                     Margin="{DynamicResource Form.HorizontalMargin}"
                                     Text="{Binding NewExtension}"
                                     PlaceholderText="{localization:Loc Settings_ExtensionPlaceholder}"
                                     UseFloatingPlaceholder="True" />
                            <TextBox Grid.Column="1"
                                     Margin="{DynamicResource Form.HorizontalMargin}"
                                     Text="{Binding NewName}"
                                     PlaceholderText="{localization:Loc Settings_DisplayNamePlaceholder}"
                                     UseFloatingPlaceholder="True" />
                            <Button Grid.Column="2"
                                    Content="{localization:Loc Settings_Add}"
                                    Command="{Binding AddAssociationCommand}"
                                    MinWidth="{DynamicResource Control.MinWidth.Medium}"
                                    Background="{DynamicResource ThemeAccentBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Background="{DynamicResource ThemeBackgroundBrush}"
                        CornerRadius="{DynamicResource BorderRadius.Small}"
                        Padding="{DynamicResource Padding.Medium}"
                        Margin="{DynamicResource MarginBottom.Medium}">
                    <StackPanel>
                        <TextBlock Text="{localization:Loc Settings_EditSelectedAssociation}"
                                   FontWeight="Bold"
                                   FontSize="{DynamicResource Font.Size.SectionHeader}"
                                   Margin="{DynamicResource MarginBottom.Medium}" />

                        <Grid ColumnDefinitions="*,Auto"
                              Margin="{DynamicResource MarginVertical.Small}">
                            <TextBox Grid.Column="0"
                                     Margin="{DynamicResource Form.HorizontalMargin}"
                                     Text="{Binding SelectedAssociation.ApplicationPath, Mode=TwoWay}"
                                     IsEnabled="{Binding SelectedAssociation}"
                                     PlaceholderText="{localization:Loc Settings_PathPlaceholder}"
                                     UseFloatingPlaceholder="True" />
                            <Button Grid.Column="1"
                                    Content="{localization:Loc Settings_Browse}"
                                    Command="{Binding EditApplicationPathCommand}"
                                    IsEnabled="{Binding SelectedAssociation}"
                                    MinWidth="{DynamicResource Control.MinWidth.Medium}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        Background="{DynamicResource ThemeBackgroundBrush}"
                        CornerRadius="{DynamicResource BorderRadius.Small}"
                        Padding="{DynamicResource Padding.Medium}"
                        Margin="{DynamicResource MarginBottom.Medium}">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Row="0"
                                   Text="{localization:Loc Settings_CurrentAssociations}"
                                   FontWeight="Bold"
                                   FontSize="{DynamicResource Font.Size.SectionHeader}"
                                   Margin="{DynamicResource MarginBottom.Medium}" />

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Associations}"
                                 SelectedItem="{Binding SelectedAssociation}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Margin="{DynamicResource MarginVertical.Small}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="100,*,*"
                                          Margin="{DynamicResource MarginAll.Small}">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding FileExtension}"
                                                   FontWeight="Bold"
                                                   Margin="{DynamicResource MarginAll.Small}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   Margin="{DynamicResource MarginAll.Small}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ApplicationPath}"
                                                   Margin="{DynamicResource MarginAll.Small}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>

                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="{DynamicResource Padding.Small}" />
                                    <Setter Property="Cursor" Value="Hand" />
                                </Style>
                            </ListBox.Styles>
                        </ListBox>

                        <Button Grid.Row="2"
                                Content="{localization:Loc Settings_RemoveSelected}"
                                Command="{Binding RemoveAssociationCommand}"
                                HorizontalAlignment="Right"
                                Margin="{DynamicResource MarginTop.Medium}"
                                MinWidth="{DynamicResource Control.MinWidth.Large}"
                                IsEnabled="{Binding SelectedAssociation}"
                                Background="{DynamicResource ThemeDangerBrush}" />
                    </Grid>
                </Border>

                <TextBlock Grid.Row="3"
                           Text="{localization:Loc Settings_AssociationDescription}"
                           FontStyle="Italic"
                           FontSize="{DynamicResource Font.Size.Small}"
                           Foreground="{DynamicResource ThemeForegroundBrush}"
                           Opacity="0.7"
                           TextWrapping="Wrap"
                           Margin="{DynamicResource MarginAll.Small}" />
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
