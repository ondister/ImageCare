<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ImageCare.UI.Avalonia.ViewModels"
             xmlns:domain="clr-namespace:ImageCare.UI.Avalonia.ViewModels.Domain"
             xmlns:localization="clr-namespace:ImageCare.UI.Avalonia.Localization"
             mc:Ignorable="d"
             x:DataType="viewModels:SettingsViewModel"
             x:Class="ImageCare.UI.Avalonia.Views.SettingsView">

    <TabControl Margin="{DynamicResource MarginAll.Medium}">
        <TabItem Header="{localization:Loc Settings_General}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="{DynamicResource MarginAll.Medium}"
                            Spacing="8">
                <TextBlock Text="{localization:Loc Settings_InterfaceLanguage}"
                           FontWeight="Bold"
                           FontSize="{DynamicResource Font.Size.SectionHeader}" />
                <ComboBox ItemsSource="{Binding AvailableLanguages}"
                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                          MinWidth="240"
                          HorizontalAlignment="Left">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="localization:LanguageOption">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{localization:Loc Settings_LanguageDescription}"
                           Opacity="0.7"
                           TextWrapping="Wrap" />

                <Separator Margin="{DynamicResource MarginVertical.Small}" />

                <ToggleSwitch Content="{localization:Loc Settings_RestoreLastFolders}"
                              IsChecked="{Binding RestoreLastFoldersOnStartup, Mode=TwoWay}" />
                <TextBlock Text="{localization:Loc Settings_RestoreLastFoldersDescription}"
                           Opacity="0.7"
                           TextWrapping="Wrap" />

                <Separator Margin="{DynamicResource MarginVertical.Small}" />

                <TextBlock Text="{localization:Loc Settings_HelpTitle}"
                           FontWeight="Bold"
                           FontSize="{DynamicResource Font.Size.SectionHeader}" />
                <ToggleSwitch Content="{localization:Loc Settings_AdaptiveHelp}"
                              IsChecked="{Binding AdaptiveHelpEnabled, Mode=TwoWay}" />
                <TextBlock Text="{localization:Loc Settings_AdaptiveHelpDescription}"
                           Opacity="0.7"
                           TextWrapping="Wrap" />

                <Separator Margin="{DynamicResource MarginVertical.Small}" />

                <TextBlock Text="{localization:Loc Settings_DragDropBehavior}"
                           FontWeight="Bold"
                           FontSize="{DynamicResource Font.Size.SectionHeader}" />
                <TextBlock Text="{localization:Loc Settings_DragDropModifier}" />
                <ComboBox ItemsSource="{Binding DragDropModifierOptions}"
                          SelectedItem="{Binding SelectedDragDropModifier, Mode=TwoWay}"
                          MinWidth="240"
                          HorizontalAlignment="Left">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="domain:DragDropModifierOption">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox Content="{localization:Loc Settings_CopyOnDragDropByDefault}"
                          IsChecked="{Binding CopyOnDragDropByDefault, Mode=TwoWay}" />
                <TextBlock Text="{localization:Loc Settings_DragDropDescription}"
                           Opacity="0.7"
                           TextWrapping="Wrap" />

                <Separator Margin="{DynamicResource MarginVertical.Small}" />

                <ToggleSwitch Content="{localization:Loc Settings_FolderTags}"
                              IsChecked="{Binding FolderTagsEnabled, Mode=TwoWay}" />
                <TextBlock Text="{localization:Loc Settings_FolderTagsDescription}"
                           Opacity="0.7"
                           TextWrapping="Wrap" />
                <CheckBox Content="{localization:Loc Settings_FolderTagsLog}"
                          IsChecked="{Binding FolderTagApplicationLogEnabled, Mode=TwoWay}"
                          IsEnabled="{Binding FolderTagsEnabled}" />

                <Separator Margin="{DynamicResource MarginVertical.Small}" />

                <ToggleSwitch Content="{localization:Loc Settings_SafeDeletion}"
                              IsChecked="{Binding SafeDeletionEnabled, Mode=TwoWay}" />
                <TextBlock Text="{localization:Loc Settings_SafeDeletionDescription}"
                           Opacity="0.7"
                           TextWrapping="Wrap" />

                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="8"
                      IsEnabled="{Binding SafeDeletionEnabled}">
                    <TextBlock Grid.Column="0"
                               Text="{localization:Loc Settings_SafeDeletionFolder}"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Text="{Binding SafeDeletionDirectoryPath, Mode=TwoWay}"
                             MinWidth="360" />
                    <Button Grid.Column="2"
                            Content="{localization:Loc Settings_Browse}"
                            Command="{Binding ChooseSafeDeletionDirectoryCommand}" />
                </Grid>

                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            IsEnabled="{Binding SafeDeletionEnabled}">
                    <TextBlock Text="{localization:Loc Settings_SafeDeletionMaxFiles}"
                               VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding SafeDeletionMaxFileCount, Mode=TwoWay}"
                                   Minimum="1"
                                   Maximum="10000"
                                   Increment="1"
                                   Width="100" />
                </StackPanel>

                <Separator Margin="{DynamicResource MarginVertical.Small}" />

                <ToggleSwitch Content="{localization:Loc Settings_McpServer}"
                              IsChecked="{Binding McpServerEnabled, Mode=TwoWay}" />
                <TextBlock Text="{localization:Loc Settings_McpServerDescription}"
                           Opacity="0.7"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            IsEnabled="{Binding McpServerEnabled}">
                    <TextBlock Text="{localization:Loc Settings_McpServerPort}"
                               VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding McpServerPort, Mode=TwoWay}"
                                   Minimum="1024"
                                   Maximum="65535"
                                   Increment="1"
                                   Width="120" />
                </StackPanel>
                <TextBlock Text="{Binding McpServerStatus}"
                           Opacity="0.7"
                           TextWrapping="Wrap" />
            </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="{localization:Loc Settings_FileAssociations}">
            <Grid RowDefinitions="Auto,*,Auto" Margin="0" VerticalAlignment="Stretch">
                <Border Grid.Row="0"
                        Background="{DynamicResource ThemeBackgroundBrush}"
                        CornerRadius="{DynamicResource BorderRadius.Small}"
                        Padding="{DynamicResource Padding.Medium}"
                        Margin="{DynamicResource MarginBottom.Medium}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{localization:Loc Settings_AddNewAssociation}"
                                   FontWeight="Bold"
                                   FontSize="{DynamicResource Font.Size.SectionHeader}" />
                        <TextBlock Text="{localization:Loc Settings_AddAssociationDescription}"
                                   Opacity="0.7"
                                   TextWrapping="Wrap" />

                        <Grid ColumnDefinitions="160,*,Auto,Auto"
                              ColumnSpacing="8"
                              Margin="{DynamicResource MarginVertical.Small}">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding SupportedExtensions}"
                                      SelectedItem="{Binding NewExtension, Mode=TwoWay}" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding ApplicationChoices}"
                                      SelectedItem="{Binding SelectedApplicationChoice, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="domain:ApplicationChoiceViewModel">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="2"
                                    Content="{localization:Loc Settings_ChooseApplication}"
                                    Command="{Binding ChooseApplicationCommand}"
                                    IsVisible="{Binding IsCustomApplicationSelected}"
                                    MinWidth="140" />
                            <Button Grid.Column="3"
                                    Content="{localization:Loc Settings_Add}"
                                    Command="{Binding AddAssociationCommand}"
                                    MinWidth="{DynamicResource Control.MinWidth.Medium}"
                                    Background="{DynamicResource ThemeAccentBrush}" />
                        </Grid>

                        <TextBlock Text="{Binding NewApplicationPath}"
                                   IsVisible="{Binding IsCustomApplicationSelected}"
                                   TextTrimming="CharacterEllipsis"
                                   Opacity="0.7" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Background="{DynamicResource ThemeBackgroundBrush}"
                        CornerRadius="{DynamicResource BorderRadius.Small}"
                        Padding="{DynamicResource Padding.Medium}"
                        Margin="{DynamicResource MarginBottom.Medium}">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Row="0"
                                   Text="{localization:Loc Settings_CurrentAssociations}"
                                   FontWeight="Bold"
                                   FontSize="{DynamicResource Font.Size.SectionHeader}"
                                   Margin="{DynamicResource MarginBottom.Medium}" />

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Associations}"
                                 SelectedItem="{Binding SelectedAssociation}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Margin="{DynamicResource MarginVertical.Small}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="domain:FileApplicationAssociationViewModel">
                                    <Grid ColumnDefinitions="100,220,*"
                                          Margin="{DynamicResource MarginAll.Small}">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding FileExtension}"
                                                   FontWeight="Bold"
                                                   Margin="{DynamicResource MarginAll.Small}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   Margin="{DynamicResource MarginAll.Small}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ApplicationPath}"
                                                   Margin="{DynamicResource MarginAll.Small}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>

                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="{DynamicResource Padding.Small}" />
                                    <Setter Property="Cursor" Value="Hand" />
                                </Style>
                            </ListBox.Styles>
                        </ListBox>

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="8"
                                    Margin="{DynamicResource MarginTop.Medium}">
                            <Button Content="{localization:Loc Settings_RestoreRecommended}"
                                    Command="{Binding RestoreRecommendedApplicationsCommand}"
                                    MinWidth="{DynamicResource Control.MinWidth.Large}" />
                            <Button Content="{localization:Loc Settings_RemoveSelected}"
                                    Command="{Binding RemoveAssociationCommand}"
                                    MinWidth="{DynamicResource Control.MinWidth.Large}"
                                    IsEnabled="{Binding SelectedAssociation}"
                                    Background="{DynamicResource ThemeDangerBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="2"
                           Text="{localization:Loc Settings_AssociationDescription}"
                           FontStyle="Italic"
                           FontSize="{DynamicResource Font.Size.Small}"
                           Foreground="{DynamicResource ThemeForegroundBrush}"
                           Opacity="0.7"
                           TextWrapping="Wrap"
                           Margin="{DynamicResource MarginAll.Small}" />
            </Grid>
        </TabItem>

        <TabItem Header="{localization:Loc Annotations_SettingsTab}">
            <Grid RowDefinitions="Auto,*,Auto,*" RowSpacing="10" Margin="12">
                <StackPanel Grid.Row="0" Spacing="6">
                    <TextBlock Text="{localization:Loc Annotations_RootsTitle}" FontWeight="Bold" FontSize="{DynamicResource Font.Size.SectionHeader}" />
                    <TextBlock Text="{localization:Loc Annotations_RootsDescription}" Opacity="0.7" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{localization:Loc Annotations_AddRoot}" Command="{Binding AddMediaSearchRootCommand}" />
                        <Button Content="{localization:Loc Annotations_RemoveRoot}" Command="{Binding RemoveMediaSearchRootCommand}" />
                        <Button Content="{localization:Loc Annotations_Rebuild}" Command="{Binding RebuildMediaIndexCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding AnnotationsStatus}" TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsAnnotationsBusy}" Height="4" />
                </StackPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding MediaSearchRootPaths}" SelectedItem="{Binding SelectedMediaSearchRoot}" MinHeight="120" />

                <StackPanel Grid.Row="2" Spacing="6">
                    <TextBlock Text="{localization:Loc Annotations_TagsTitle}" FontWeight="Bold" FontSize="{DynamicResource Font.Size.SectionHeader}" />
                    <TextBlock Text="{localization:Loc Annotations_TagsDescription}" Opacity="0.7" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Text="{Binding NewPinnedTag}" PlaceholderText="{localization:Loc Annotations_NewTag}" />
                        <Button Grid.Column="1" Content="{localization:Loc Settings_Add}" Command="{Binding AddPinnedTagCommand}" />
                        <Button Grid.Column="2" Content="{localization:Loc Settings_RemoveSelected}" Command="{Binding RemovePinnedTagCommand}" />
                        <Button Grid.Column="3" Content="{localization:Loc Annotations_ImportTags}" Command="{Binding ImportPinnedTagsCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding TagImportStatus}"
                               Opacity="0.7"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ListBox Grid.Row="3" ItemsSource="{Binding AvailableTags}" SelectedItem="{Binding SelectedPinnedTag}" MinHeight="120" />
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
