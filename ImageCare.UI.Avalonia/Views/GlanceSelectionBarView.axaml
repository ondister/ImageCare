<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:ImageCare.UI.Avalonia.Views"
             xmlns:viewModels="clr-namespace:ImageCare.UI.Avalonia.ViewModels"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             xmlns:localization="clr-namespace:ImageCare.UI.Avalonia.Localization"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             x:Class="ImageCare.UI.Avalonia.Views.GlanceSelectionBarView"
             x:DataType="viewModels:GlancePanelViewModel">

    <Border IsVisible="{Binding Selection.HasSelection}"
            Margin="2,2,2,6"
            Padding="10"
            CornerRadius="{DynamicResource BorderRadius.Medium}"
            Background="{DynamicResource Brush.AccentSubtle}">
        <StackPanel Spacing="8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                <TextBlock Grid.Column="0"
                           Text="{Binding Selection.SelectionSummary}"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Selection.AnnotatableSelectionSummary}"
                           Opacity="0.7"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Content="{localization:Loc Action_Copy}"
                        Command="{Binding Batch.CopySelectionCommand}"
                        IsEnabled="{Binding Batch.CanTransferSelection}"
                        ToolTip.Tip="{Binding Batch.CopySelectionToolTip}" />
                <Button Grid.Column="3"
                        Content="{localization:Loc Action_Move}"
                        Command="{Binding Batch.MoveSelectionCommand}"
                        IsEnabled="{Binding Batch.CanTransferSelection}"
                        ToolTip.Tip="{Binding Batch.MoveSelectionToolTip}" />
                <Button Grid.Column="4"
                        Content="{localization:Loc Batch_ExportJpegShort}"
                        Command="{Binding Batch.ExportSelectionCommand}"
                        IsEnabled="{Binding Batch.CanExportSelection}"
                        ToolTip.Tip="{localization:Loc Batch_ExportJpegTooltip}" />
                <Button Grid.Column="5"
                        Content="{localization:Loc Common_Delete}"
                        Command="{Binding Batch.DeleteSelectionCommand}"
                        IsEnabled="{Binding Batch.CanRunOverviewOperation}"
                        Foreground="{DynamicResource Brush.Danger}"
                        ToolTip.Tip="{localization:Loc Batch_DeleteSelection}" />
                <Button Grid.Column="6"
                        Content="{localization:Loc Batch_ClearSelection}"
                        Command="{Binding Selection.ClearSelectionCommand}"
                        IsEnabled="{Binding !Operations.IsOverviewOperationRunning}"
                        ToolTip.Tip="{localization:Loc Batch_ClearSelection}" />
            </Grid>

            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        ToolTip.Tip="{Binding Batch.TransferDestinationText}">
                <iconPacks:PackIconLucide Kind="FolderInput"
                                         Width="14"
                                         Height="14"
                                         VerticalAlignment="Center" />
                <TextBlock Text="{Binding Batch.TransferDestinationText}"
                           FontSize="11"
                           Opacity="0.75"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </StackPanel>

            <views:GlanceAnnotationEditorView DataContext="{Binding Annotations}" />

            <views:GlanceOperationProgressView DataContext="{Binding Operations}" />
        </StackPanel>
    </Border>
</UserControl>
