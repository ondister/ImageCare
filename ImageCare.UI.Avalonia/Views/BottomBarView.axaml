<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvvm="http://prismlibrary.com/"
             xmlns:viewModels="clr-namespace:ImageCare.UI.Avalonia.ViewModels"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             xmlns:domain="clr-namespace:ImageCare.UI.Avalonia.ViewModels.Domain"
             xmlns:localization="clr-namespace:ImageCare.UI.Avalonia.Localization"
             x:Class="ImageCare.UI.Avalonia.Views.BottomBarView"
             mvvm:ViewModelLocator.AutoWireViewModel="True"
             x:DataType="viewModels:BottomBarViewModel"
             Height="24"
             MinHeight="24"
             MaxHeight="24">
    <UserControl.Styles>
        <Style Selector="iconPacks|PackIconLucide">
            <Setter Property="Width" Value="{StaticResource Icon.Size.Micro}" />
            <Setter Property="Height" Value="{StaticResource Icon.Size.Micro}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.StatusBarButton">
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="{StaticResource Font.Size.Small}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.StatusText">
            <Setter Property="FontSize" Value="{StaticResource Font.Size.Small}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
    </UserControl.Styles>

    <Border Height="24"
            BorderBrush="{DynamicResource Brush.Splitter}"
            BorderThickness="0,1,0,0"
            Background="{DynamicResource ThemeBackgroundBrush}">
        <Grid Height="23" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
            <Border Grid.Column="0"
                    Height="22"
                    Padding="6,0"
                    Background="{DynamicResource Brush.AccentSubtle}"
                    VerticalAlignment="Center"
                    ToolTip.Tip="{localization:Loc FileOperation_CurrentDescription}">
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <TextBlock Classes="StatusText"
                               Text="{localization:Loc FileOperation_Current}" />
                    <TextBlock Classes="StatusText"
                               Text="{localization:Loc Action_Copy}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Accent}"
                               IsVisible="{Binding IsCopyFileTransferOperation}" />
                    <TextBlock Classes="StatusText"
                               Text="{localization:Loc Action_Move}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Accent}"
                               IsVisible="{Binding IsMoveFileTransferOperation}" />
                    <TextBlock Classes="StatusText"
                               Text="{localization:Loc FileOperation_DefaultMarker}"
                               Opacity="0.7"
                               IsVisible="{Binding !IsFileTransferModifierActive}" />
                    <TextBlock Classes="StatusText"
                               Text="{localization:Loc FileOperation_HotkeyMarker}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Accent}"
                               IsVisible="{Binding IsFileTransferModifierActive}" />
                </StackPanel>
            </Border>

            <Button Grid.Column="1"
                    Classes="StatusBarButton"
                    Command="{Binding UndoDeleteCommand}"
                    IsVisible="{Binding CanUndoDelete}"
                    ToolTip.Tip="{localization:Loc Action_UndoDelete}">
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <iconPacks:PackIconLucide Kind="Undo2" />
                    <TextBlock Classes="StatusText" Text="{localization:Loc Common_Undo}" />
                </StackPanel>
            </Button>

            <ContentControl Grid.Column="2"
                            Margin="6,0"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Stretch"
                            ClipToBounds="True"
                            Content="{Binding NotificationViewModel}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="domain:SuccessNotificationViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <iconPacks:PackIconMaterial Grid.Column="0"
                                                        Kind="CheckCircleOutline"
                                                        Foreground="{DynamicResource Brush.Success}"
                                                        Height="{StaticResource Icon.Size.Micro}"
                                                        Width="{StaticResource Icon.Size.Micro}"
                                                        Margin="0,0,4,0" />
                            <TextBlock Grid.Column="1"
                                       Classes="StatusText"
                                       Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2"
                                       Classes="StatusText"
                                       Margin="4,0,0,0"
                                       Text="{Binding Description}" />
                        </Grid>
                    </DataTemplate>

                    <DataTemplate DataType="domain:ErrorNotificationViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <iconPacks:PackIconMaterial Grid.Column="0"
                                                        Kind="AlertCircleOutline"
                                                        Foreground="{DynamicResource Brush.Danger}"
                                                        Height="{StaticResource Icon.Size.Micro}"
                                                        Width="{StaticResource Icon.Size.Micro}"
                                                        Margin="0,0,4,0" />
                            <TextBlock Grid.Column="1"
                                       Classes="StatusText"
                                       Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2"
                                       Classes="StatusText"
                                       Margin="4,0,0,0"
                                       Text="{Binding Description}" />
                        </Grid>
                    </DataTemplate>

                    <DataTemplate DataType="domain:NotificationViewModel">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Classes="StatusText"
                                       Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1"
                                       Classes="StatusText"
                                       Margin="4,0,0,0"
                                       Text="{Binding Description}" />
                        </Grid>
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>

            <Button Grid.Column="3"
                    Classes="StatusBarButton"
                    Command="{Binding OpenSettingsWindowCommand}">
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <iconPacks:PackIconLucide Kind="Settings" />
                    <TextBlock Classes="StatusText" Text="{localization:Loc Bottom_Settings}" />
                </StackPanel>
            </Button>

            <Button Grid.Column="4"
                    Classes="StatusBarButton"
                    Command="{Binding OpenLogWindowCommand}">
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <iconPacks:PackIconLucide Kind="List" />
                    <Border Background="{DynamicResource Brush.Danger}"
                            CornerRadius="6"
                            Padding="3,0"
                            Height="14"
                            VerticalAlignment="Center"
                            IsVisible="{Binding !!MessagesCount}">
                        <TextBlock Text="{Binding MessagesCount}"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="{StaticResource Font.Size.Micro}"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Classes="StatusText" Text="{localization:Loc Bottom_MessagesList}" />
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
