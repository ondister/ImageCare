<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvvm="http://prismlibrary.com/"
             xmlns:viewModels="clr-namespace:ImageCare.UI.Avalonia.ViewModels"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             xmlns:domain="clr-namespace:ImageCare.UI.Avalonia.ViewModels.Domain"
             xmlns:localization="clr-namespace:ImageCare.UI.Avalonia.Localization"
             x:Class="ImageCare.UI.Avalonia.Views.BottomBarView"
             mvvm:ViewModelLocator.AutoWireViewModel="True"
             x:DataType="viewModels:BottomBarViewModel">
    <UserControl.Styles>
        <Style Selector="iconPacks|PackIconLucide">
            <Setter Property="Width" Value="{StaticResource Icon.Size.Small}" />
            <Setter Property="Height" Value="{StaticResource Icon.Size.Small}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <Separator Grid.Row="0" />

        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto"
              Margin="{StaticResource MarginTop.Medium}">
            <Button Grid.Column="0"
                    Classes="ToolbarButton"
                    Command="{Binding OpenLogWindowCommand}"
                    Margin="{StaticResource MarginHorizontal.Small}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <iconPacks:PackIconLucide Kind="List" />
                    <Border Background="{DynamicResource Brush.Danger}"
                            CornerRadius="8"
                            Padding="4,2"
                            VerticalAlignment="Center"
                            IsVisible="{Binding !!MessagesCount}">
                        <TextBlock Text="{Binding MessagesCount}"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="{DynamicResource Font.Size.Micro}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{localization:Loc Bottom_MessagesList}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <ContentControl Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Content="{Binding NotificationViewModel}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="domain:SuccessNotificationViewModel">
                        <StackPanel Margin="{StaticResource MarginHorizontal.Small}" Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="CheckCircleOutline"
                                                        Foreground="{DynamicResource Brush.Success}"
                                                        Height="{StaticResource Icon.Size.Small}"
                                                        Width="{StaticResource Icon.Size.Small}"
                                                        Margin="{StaticResource MarginHorizontal.Small}" />
                            <TextBlock Margin="{StaticResource MarginHorizontal.Small}" Text="{Binding Title}" />
                            <TextBlock Margin="{StaticResource MarginHorizontal.Small}" Text="{Binding Description}" />
                        </StackPanel>
                    </DataTemplate>

                    <DataTemplate DataType="domain:ErrorNotificationViewModel">
                        <StackPanel Margin="{StaticResource MarginHorizontal.Small}" Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="AlertCircleOutline"
                                                        Foreground="{DynamicResource Brush.Danger}"
                                                        Height="{StaticResource Icon.Size.Small}"
                                                        Width="{StaticResource Icon.Size.Small}"
                                                        Margin="{StaticResource MarginHorizontal.Small}" />
                            <TextBlock Margin="{StaticResource MarginHorizontal.Small}" Text="{Binding Title}" />
                            <TextBlock Margin="{StaticResource MarginHorizontal.Small}" Text="{Binding Description}" />
                        </StackPanel>
                    </DataTemplate>

                    <DataTemplate DataType="domain:NotificationViewModel">
                        <StackPanel Margin="{StaticResource MarginHorizontal.Small}" Orientation="Horizontal">
                            <TextBlock Margin="{StaticResource MarginHorizontal.Small}" Text="{Binding Title}" />
                            <TextBlock Margin="{StaticResource MarginHorizontal.Small}" Text="{Binding Description}" />
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>

            <Button Grid.Column="2"
                    Classes="ToolbarButton"
                    Command="{Binding UndoDeleteCommand}"
                    IsVisible="{Binding CanUndoDelete}"
                    HorizontalAlignment="Left"
                    Margin="{StaticResource MarginHorizontal.Small}"
                    ToolTip.Tip="{localization:Loc Action_UndoDelete}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <iconPacks:PackIconLucide Kind="Undo2" />
                    <TextBlock Text="{localization:Loc Common_Undo}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Grid.Column="3"
                    Classes="ToolbarButton"
                    Command="{Binding OpenSettingsWindowCommand}"
                    Margin="{StaticResource MarginHorizontal.Small}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <iconPacks:PackIconLucide Kind="Settings" />
                    <TextBlock Text="{localization:Loc Bottom_Settings}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
