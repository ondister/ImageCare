<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ImageCare.UI.Avalonia.ViewModels"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:ui="clr-namespace:ImageCare.UI.Avalonia"
        xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
        xmlns:views="clr-namespace:ImageCare.UI.Avalonia.Views"
        xmlns:localization="clr-namespace:ImageCare.UI.Avalonia.Localization"
        x:Class="ImageCare.UI.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/imagecare-logo.ico"
        Title="ImageCare"
        MinHeight="600"
        MinWidth="800"
        WindowState="Maximized"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Loaded="OnWindowLoaded"
        Closing="OnWindowClosing">
    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="280" MinHeight="250" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.2*" MinWidth="400" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="0.2*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <ContentControl Grid.Column="0"
                            prism:RegionManager.RegionName="{x:Static ui:RegionNames.SourceFoldersRegion}" />
            <GridSplitter Grid.Column="1" VerticalAlignment="Stretch" ShowsPreview="True" />
            <Grid Grid.Column="2">
                <Grid IsVisible="{Binding IsImageViewVisible}">
                    <views:MainImageView DataContext="{Binding MainImageViewModel}" />
                </Grid>
                <Grid IsVisible="{Binding IsVideoViewVisible}">
                    <views:MainVideoView DataContext="{Binding MainVideoViewModel}" />
                </Grid>
            </Grid>
            <GridSplitter Grid.Column="3" VerticalAlignment="Stretch" ShowsPreview="True" />
            <ContentControl Grid.Column="4"
                            prism:RegionManager.RegionName="{x:Static ui:RegionNames.TargetFoldersRegion}" />
        </Grid>

        <Separator Grid.Row="1" HorizontalAlignment="Stretch" />

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,*">
            <ContentControl Grid.Column="0"
                            Margin="{StaticResource MarginRight.Medium}"
                            prism:RegionManager.RegionName="{x:Static ui:RegionNames.SourcePreviewImageRegion}" />

            <GridSplitter Grid.Column="1"
                          VerticalAlignment="Stretch"
                          ShowsPreview="True" />

            <StackPanel Grid.Column="1"
                        Panel.ZIndex="1"
                        Orientation="Vertical"
                        VerticalAlignment="Center"
                        Cursor="Arrow">
                <Button Margin="{StaticResource MarginAll.Small}"
                        Classes="IconButton"
                        Cursor="Arrow"
                        Command="{CompiledBinding CopySelectedPreviewCommand}"
                        ToolTip.Tip="{localization:Loc Action_Copy}">
                    <iconPacks:PackIconMaterial Kind="ContentCopy"
                                                Height="{StaticResource Icon.Size.Small}"
                                                Width="{StaticResource Icon.Size.Small}" />
                </Button>
                <Button Margin="{StaticResource MarginAll.Small}"
                        Classes="IconButton"
                        Cursor="Arrow"
                        Command="{CompiledBinding MoveSelectedPreviewCommand}"
                        ToolTip.Tip="{localization:Loc Action_Move}">
                    <iconPacks:PackIconMaterial Kind="FileReplaceOutline"
                                                Height="{StaticResource Icon.Size.Small}"
                                                Width="{StaticResource Icon.Size.Small}" />
                </Button>
                <ToggleButton Margin="{StaticResource MarginAll.Small}"
                              MinWidth="32"
                              MinHeight="32"
                              Padding="6"
                              Cursor="Arrow"
                              IsChecked="{CompiledBinding RenameFileOnTransfer, Mode=TwoWay}"
                              ToolTip.Tip="{localization:Loc FileOperation_RenameMode}">
                    <iconPacks:PackIconMaterial Kind="RenameBox"
                                                Height="{StaticResource Icon.Size.Small}"
                                                Width="{StaticResource Icon.Size.Small}" />
                </ToggleButton>
            </StackPanel>

            <ContentControl Grid.Column="2"
                            Margin="{StaticResource MarginLeft.Medium}"
                            prism:RegionManager.RegionName="{x:Static ui:RegionNames.TargetPreviewImageRegion}" />
        </Grid>

        <ContentControl Grid.Row="3"
                        prism:RegionManager.RegionName="{x:Static ui:RegionNames.BottomBarRegion}" />

        <!-- Adaptive help has one host for the entire application. -->
        <Button Grid.RowSpan="4"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="12"
                Width="36"
                Height="36"
                FontSize="18"
                FontWeight="Bold"
                Content="?"
                Command="{Binding AdaptiveHelp.ShowHelpCommand}"
                ToolTip.Tip="{localization:Loc Help_Open}" />

        <Border Grid.RowSpan="4"
                IsVisible="{Binding AdaptiveHelp.IsVisible}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="16"
                Width="520"
                MaxWidth="520"
                Padding="16"
                CornerRadius="{DynamicResource BorderRadius.Medium}"
                Background="{DynamicResource Brush.PreviewCard}"
                BorderBrush="{DynamicResource Brush.Accent}"
                BorderThickness="1">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding AdaptiveHelp.Title}"
                           FontSize="{DynamicResource Font.Size.SectionHeader}"
                           FontWeight="Bold"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding AdaptiveHelp.Message}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding AdaptiveHelp.Reason}"
                           FontSize="{DynamicResource Font.Size.Small}"
                           Opacity="0.65"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8"
                            Margin="{DynamicResource MarginTop.Medium}">
                    <Button Content="{localization:Loc Help_DontShowAgain}"
                            Command="{Binding AdaptiveHelp.DismissCommand}" />
                    <Button Content="{localization:Loc Help_Close}"
                            Command="{Binding AdaptiveHelp.HideCommand}" />
                    <Button Content="{localization:Loc Help_GotIt}"
                            Command="{Binding AdaptiveHelp.CompleteCommand}"
                            Background="{DynamicResource Brush.Accent}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
