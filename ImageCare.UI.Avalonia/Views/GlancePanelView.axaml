<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mvvm="http://prismlibrary.com/"
             xmlns:views="clr-namespace:ImageCare.UI.Avalonia.Views"
             xmlns:viewModels="clr-namespace:ImageCare.UI.Avalonia.ViewModels"
             xmlns:localization="clr-namespace:ImageCare.UI.Avalonia.Localization"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="700"
             mvvm:ViewModelLocator.AutoWireViewModel="True"
             x:Class="ImageCare.UI.Avalonia.Views.GlancePanelView"
             x:DataType="viewModels:GlancePanelViewModel">

    <Grid RowDefinitions="Auto,*"
          Margin="{StaticResource MarginAll.Small}">
        <views:GlanceToolbarView Grid.Row="0" />

        <TabControl Grid.Row="1">
            <TabItem Header="{localization:Loc Overview_Files}">
                <Grid RowDefinitions="Auto,*,Auto">
                    <views:GlanceSelectionBarView Grid.Row="0" />
                    <views:GlanceGridView Grid.Row="1"
                                          DataContext="{Binding PreviewGrid}" />
                    <views:GlanceZoomBarView Grid.Row="2" />
                </Grid>
            </TabItem>

            <TabItem Header="{localization:Loc Overview_Deleted}">
                <views:GlanceDeletedFilesView DataContext="{Binding DeletedFiles}" />
            </TabItem>
        </TabControl>

        <views:AdaptiveHelpPanel Grid.RowSpan="2"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Stretch"
                                 Margin="8"
                                 Width="460"
                                 DataContext="{Binding AdaptiveHelp}" />
    </Grid>
</UserControl>
