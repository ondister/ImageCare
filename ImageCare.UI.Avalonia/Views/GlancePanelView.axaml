<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mvvm="http://prismlibrary.com/"
             xmlns:views="clr-namespace:ImageCare.UI.Avalonia.Views"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             xmlns:domain="clr-namespace:ImageCare.UI.Avalonia.ViewModels.Domain"
             xmlns:controls="clr-namespace:ImageCare.UI.Avalonia.Controls"
             xmlns:behaviors="clr-namespace:ImageCare.UI.Avalonia.Behaviors"
             xmlns:viewModels="clr-namespace:ImageCare.UI.Avalonia.ViewModels"
             xmlns:localization="clr-namespace:ImageCare.UI.Avalonia.Localization"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="700"
             mvvm:ViewModelLocator.AutoWireViewModel="True"
             x:Class="ImageCare.UI.Avalonia.Views.GlancePanelView"
             x:DataType="viewModels:GlancePanelViewModel">

    <Grid RowDefinitions="Auto,*"
          Margin="{StaticResource MarginAll.Small}">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <views:TimelineView Grid.Column="0"
                                DataContext="{Binding TimelineVm}" />
            <Button Grid.Column="1"
                    Width="32"
                    Height="32"
                    Padding="4"
                    Margin="2,0,0,0"
                    VerticalAlignment="Center"
                    Command="{Binding ToggleSortDirectionCommand}"
                    IsEnabled="{Binding CanChangeSort}">
                <Grid>
                    <TextBlock Text="↓"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding !IsSortAscending}" />
                    <TextBlock Text="↑"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsSortAscending}" />
                </Grid>
                <ToolTip.Tip>
                    <Grid>
                        <TextBlock Text="{localization:Loc Sort_NewestFirst}"
                                   IsVisible="{Binding !IsSortAscending}" />
                        <TextBlock Text="{localization:Loc Sort_OldestFirst}"
                                   IsVisible="{Binding IsSortAscending}" />
                    </Grid>
                </ToolTip.Tip>
            </Button>
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="{localization:Loc Overview_Files}">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Border Grid.Row="0"
                            IsVisible="{Binding HasSelection}"
                            Margin="2,2,2,6"
                            Padding="10"
                            CornerRadius="{DynamicResource BorderRadius.Medium}"
                            Background="{DynamicResource Brush.AccentSubtle}">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding SelectionSummary}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding AnnotatableSelectionSummary}"
                                           Opacity="0.7"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="2"
                                        Content="{localization:Loc Action_Copy}"
                                        Command="{Binding CopySelectionCommand}"
                                        IsEnabled="{Binding CanTransferSelection}"
                                        ToolTip.Tip="{Binding CopySelectionToolTip}" />
                                <Button Grid.Column="3"
                                        Content="{localization:Loc Action_Move}"
                                        Command="{Binding MoveSelectionCommand}"
                                        IsEnabled="{Binding CanTransferSelection}"
                                        ToolTip.Tip="{Binding MoveSelectionToolTip}" />
                                <Button Grid.Column="4"
                                        Content="{localization:Loc Batch_ExportJpegShort}"
                                        Command="{Binding ExportSelectionCommand}"
                                        IsEnabled="{Binding CanExportSelection}"
                                        ToolTip.Tip="{localization:Loc Batch_ExportJpegTooltip}" />
                                <Button Grid.Column="5"
                                        Content="{localization:Loc Common_Delete}"
                                        Command="{Binding DeleteSelectionCommand}"
                                        IsEnabled="{Binding CanRunOverviewOperation}"
                                        Foreground="{DynamicResource Brush.Danger}"
                                        ToolTip.Tip="{localization:Loc Batch_DeleteSelection}" />
                                <Button Grid.Column="6"
                                        Content="{localization:Loc Batch_ClearSelection}"
                                        Command="{Binding ClearSelectionCommand}"
                                        IsEnabled="{Binding !IsOverviewOperationRunning}"
                                        ToolTip.Tip="{localization:Loc Batch_ClearSelection}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="6"
                                        ToolTip.Tip="{Binding TransferDestinationText}">
                                <iconPacks:PackIconLucide Kind="FolderInput"
                                                         Width="14"
                                                         Height="14"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TransferDestinationText}"
                                           FontSize="11"
                                           Opacity="0.75"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <Grid ColumnDefinitions="Auto,150,Auto,220,Auto" ColumnSpacing="6"
                                  IsEnabled="{Binding CanEditSelectionAnnotations}">
                                <TextBlock Grid.Column="0"
                                           Text="{localization:Loc Annotations_Rating}"
                                           VerticalAlignment="Center" />
                                <Grid Grid.Column="1">
                                    <ComboBox SelectedIndex="{Binding SelectedRating, Mode=TwoWay}"
                                              Width="150"
                                              Height="22"
                                              MinHeight="22"
                                              Padding="6,0"
                                              FontSize="12">
                                        <ComboBoxItem Content="{localization:Loc Annotations_Unrated}" />
                                        <ComboBoxItem Content="★" />
                                        <ComboBoxItem Content="★★" />
                                        <ComboBoxItem Content="★★★" />
                                        <ComboBoxItem Content="★★★★" />
                                        <ComboBoxItem Content="★★★★★" />
                                    </ComboBox>
                                    <TextBlock Text="{localization:Loc Overview_MixedRating}"
                                               IsVisible="{Binding HasMixedRating}"
                                               Margin="10,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Background="{DynamicResource Brush.PreviewCard}" />
                                </Grid>
                                <TextBlock Grid.Column="2"
                                           Text="{localization:Loc Search_Tags}"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="3"
                                         Text="{Binding NewTag, Mode=TwoWay}"
                                         PlaceholderText="{localization:Loc Overview_AddTagToSelection}" />
                                <Button Grid.Column="4"
                                        Content="{localization:Loc Settings_Add}"
                                        Command="{Binding AddTagCommand}"
                                        ToolTip.Tip="{localization:Loc Overview_AddTagToSelection}" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding SelectionTags}"
                                          IsVisible="{Binding HasSelectionTags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,5,4"
                                                Padding="7,3"
                                                Content="{Binding}"
                                                Command="{Binding $parent[UserControl].DataContext.RemoveTagCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{localization:Loc Overview_RemoveTagFromSelection}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid ColumnDefinitions="*,Auto,Auto"
                                  IsVisible="{Binding IsOverviewOperationRunning}"
                                  ColumnSpacing="8">
                                <ProgressBar Grid.Column="0"
                                             Minimum="0"
                                             Maximum="{Binding BatchTotal}"
                                             Value="{Binding BatchProcessed}"
                                             VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding BatchProgressText}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="2"
                                        Content="{localization:Loc Batch_CancelOperation}"
                                        Command="{Binding CancelOverviewOperationCommand}"
                                        ToolTip.Tip="{localization:Loc Batch_CancelOperation}" />
                            </Grid>
                            <TextBlock Text="{Binding OverviewOperationStatus}"
                                       Opacity="0.7"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding PreviewRows}"
                             Padding="0"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             behaviors:ScrollToIndexBehavior.TargetIndex="{Binding ScrollTargetRowIndex}"
                             behaviors:VerticalScrollBehavior.IsEnabled="True"
                             behaviors:VerticalScrollBehavior.IsScrollResetRequested="{Binding IsScrollResetRequested, Mode=TwoWay}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel CacheLength="0.5" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="IsHitTestVisible" Value="True" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:FixedWrapPanel ItemsPerLine="{Binding $parent[UserControl].DataContext.ImagesPerLine}"
                                                                     AspectRatio="{Binding $parent[UserControl].DataContext.SelectedAspectRatio.AspectRatio}"
                                                                     RowHeight="{Binding $parent[UserControl].DataContext.PanelRowHeight, Mode=OneWayToSource}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="domain:GlanceMediaPreviewViewModel">
                                            <controls:MediaPreviewCard HorizontalAlignment="Stretch"
                                                                       VerticalAlignment="Stretch"
                                                                       SelectCommand="{Binding $parent[UserControl].DataContext.SelectPreviewCommand}"
                                                                       SelectCommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="2"
                          ColumnDefinitions="Auto,Auto,*,Auto"
                          Margin="{StaticResource MarginAll.Small}">
                        <Grid Grid.Column="0"
                              ColumnDefinitions="Auto,Auto,Auto"
                              MaxHeight="36">
                            <Button Grid.Column="0"
                                    Classes="Small"
                                    Command="{Binding ZoomOutCommand}"
                                    ToolTip.Tip="{localization:Loc Action_ZoomOut}"
                                    Margin="{StaticResource MarginAll.Small}"
                                    Padding="{StaticResource Padding.Inner}">
                                <iconPacks:PackIconLucide Kind="CircleMinus" />
                            </Button>
                            <Label Grid.Column="1"
                                   Width="30"
                                   Margin="{StaticResource MarginAll.Small}"
                                   Content="{Binding ImagesPerLine}"
                                   HorizontalContentAlignment="Center"
                                   VerticalContentAlignment="Center" />
                            <Button Grid.Column="2"
                                    Classes="Small"
                                    Command="{Binding ZoomInCommand}"
                                    ToolTip.Tip="{localization:Loc Action_ZoomIn}"
                                    Padding="{StaticResource Padding.Inner}"
                                    Margin="{StaticResource MarginAll.Small}">
                                <iconPacks:PackIconLucide Kind="CirclePlus" />
                            </Button>
                        </Grid>
                        <ComboBox Grid.Column="1"
                                  Margin="{StaticResource MarginAll.Medium}"
                                  ItemsSource="{Binding AspectRatioViewModels}"
                                  SelectedItem="{Binding SelectedAspectRatio}" />
                        <Button Grid.Column="3"
                                Classes="Small"
                                Width="26"
                                Height="26"
                                Padding="5"
                                Margin="{StaticResource MarginAll.Small}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Command="{Binding AdaptiveHelp.ShowHelpCommand}"
                                ToolTip.Tip="{localization:Loc Help_Open}">
                            <iconPacks:PackIconMaterial Kind="HelpCircleOutline" Width="13" Height="13" />
                        </Button>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{localization:Loc Overview_Deleted}">
                <Grid RowDefinitions="Auto,*">
                    <Button Grid.Row="0"
                            HorizontalAlignment="Left"
                            Margin="{StaticResource MarginAll.Small}"
                            Command="{Binding RestoreAllCommand}"
                            IsVisible="{Binding HasDeletedFiles}"
                            ToolTip.Tip="{localization:Loc Overview_RestoreAll}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <iconPacks:PackIconLucide Kind="Undo2" />
                            <TextBlock Text="{localization:Loc Overview_RestoreAll}" />
                        </StackPanel>
                    </Button>

                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="{localization:Loc Overview_NoDeleted}"
                               IsVisible="{Binding !HasDeletedFiles}" />

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding DeletedFiles}"
                             IsVisible="{Binding HasDeletedFiles}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="domain:DeletedMediaFileViewModel">
                                <Border Padding="10"
                                        Margin="2"
                                        BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource Brush.Splitter}">
                                    <Grid ColumnDefinitions="64,*,Auto">
                                        <Border Grid.Column="0"
                                                Width="56"
                                                Height="56"
                                                CornerRadius="4"
                                                ClipToBounds="True"
                                                Background="{DynamicResource Brush.PreviewSurface}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <Image Source="{Binding PreviewBitmap}"
                                                   Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock Text="{localization:Loc Overview_OriginalFolder}" Opacity="0.7" />
                                                <TextBlock Text="{Binding OriginalFolder}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock Text="{localization:Loc Overview_DeletedAt}" Opacity="0.7" />
                                                <TextBlock Text="{Binding DeletedAt}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Command="{Binding RestoreCommand}"
                                                ToolTip.Tip="{localization:Loc Overview_Restore}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <iconPacks:PackIconLucide Kind="Undo2" />
                                                <TextBlock Text="{localization:Loc Overview_Restore}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>

        <views:AdaptiveHelpPanel Grid.RowSpan="2"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Stretch"
                                 Margin="8"
                                 Width="460"
                                 DataContext="{Binding AdaptiveHelp}" />
    </Grid>
</UserControl>
