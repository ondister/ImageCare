<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:ImageCare.UI.Avalonia.ViewModels"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             xmlns:localization="clr-namespace:ImageCare.UI.Avalonia.Localization"
             x:Class="ImageCare.UI.Avalonia.Views.FolderTagsEditorView"
             x:DataType="viewModels:FolderTagsEditorViewModel">

    <UserControl.Styles>
        <Style Selector="Border.TagChip">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,3,4,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style Selector="Border.InheritedTagChip">
            <Setter Property="Background" Value="{DynamicResource Brush.PreviewSurface}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="18"
          RowDefinitions="Auto,Auto,*,Auto"
          RowSpacing="14">

        <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock Text="{Binding FolderName}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding FolderPath}"
                       Opacity="0.7"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding FolderPath}" />
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="5"
                  Margin="0,4,0,0">
                <TextBlock Text="{localization:Loc FolderTags_Editor_Descriptor}"
                           FontSize="11"
                           Opacity="0.55"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding DescriptorPath}"
                           FontSize="11"
                           Opacity="0.55"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{localization:Loc FolderTags_Editor_Description}"
                       Margin="0,8,0,0"
                       Opacity="0.8"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="7">
            <TextBlock Text="{localization:Loc FolderTags_Editor_OwnTags}"
                       FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding NewTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="{localization:Loc FolderTags_Editor_NewTagPlaceholder}"
                         IsEnabled="{Binding IsAvailable}">
                    <TextBox.KeyBindings>
                        <KeyBinding Command="{Binding AddTagCommand}" Gesture="Enter" />
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="1"
                        Content="{localization:Loc FolderTags_Editor_Add}"
                        Command="{Binding AddTagCommand}"
                        Classes="ToolbarButton" />
            </Grid>

            <ScrollViewer MaxHeight="120"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Tags}"
                              x:CompileBindings="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="TagChip">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{Binding}"
                                               MaxWidth="260"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <Button Classes="IconButton"
                                            Width="20"
                                            Height="20"
                                            MinWidth="0"
                                            MinHeight="0"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Command="{Binding $parent[UserControl].DataContext.RemoveTagCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{localization:Loc FolderTags_Editor_RemoveTag}">
                                        <iconPacks:PackIconMaterial Kind="Close"
                                                                    Width="11"
                                                                    Height="11" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="{localization:Loc FolderTags_Editor_NoOwnTags}"
                       Opacity="0.6"
                       TextWrapping="Wrap"
                       IsVisible="{Binding !HasOwnTags}" />
        </StackPanel>

        <Border Grid.Row="2"
                Padding="12"
                CornerRadius="6"
                Background="{DynamicResource Brush.PreviewSurface}">
            <Grid RowDefinitions="Auto,*" RowSpacing="8">
                <StackPanel Grid.Row="0" Spacing="2">
                    <TextBlock Text="{localization:Loc FolderTags_Editor_InheritedTags}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{localization:Loc FolderTags_Editor_InheritedHint}"
                               FontSize="11"
                               Opacity="0.65" />
                </StackPanel>
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding InheritedTags}"
                                      x:CompileBindings="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="InheritedTagChip">
                                        <TextBlock Text="{Binding}"
                                                   MaxWidth="260"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{localization:Loc FolderTags_Editor_NoInheritedTags}"
                                   Opacity="0.6"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding !HasInheritedTags}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="3"
              ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="8">
            <TextBlock Text="{Binding Status}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Opacity="0.8" />
            <Button Grid.Column="1"
                    Content="{localization:Loc Common_Save}"
                    Command="{Binding SaveCommand}"
                    Classes="ToolbarButton"
                    MinWidth="96" />
            <Button Grid.Column="2"
                    Content="{localization:Loc Common_Cancel}"
                    Command="{Binding CloseCommand}"
                    Classes="ToolbarButton"
                    MinWidth="96" />
        </Grid>
    </Grid>
</UserControl>
