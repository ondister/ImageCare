<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:domain="clr-namespace:ImageCare.UI.Avalonia.ViewModels.Domain"
             xmlns:controls="clr-namespace:ImageCare.UI.Avalonia.Controls"
             xmlns:behaviors="clr-namespace:ImageCare.UI.Avalonia.Behaviors"
             xmlns:glance="clr-namespace:ImageCare.UI.Avalonia.ViewModels.Glance"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="600"
             x:Class="ImageCare.UI.Avalonia.Views.GlanceGridView"
             x:DataType="glance:GlancePreviewGridViewModel">

    <ListBox ItemsSource="{Binding PreviewRows}"
             Padding="0"
             BorderThickness="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             behaviors:ScrollToIndexBehavior.TargetIndex="{Binding ScrollTargetRowIndex}"
             behaviors:VerticalScrollBehavior.IsEnabled="True"
             behaviors:VerticalScrollBehavior.IsScrollResetRequested="{Binding IsScrollResetRequested, Mode=TwoWay}">
        <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
                <VirtualizingStackPanel CacheLength="0.5" />
            </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.Styles>
            <Style Selector="ListBoxItem">
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="IsHitTestVisible" Value="True" />
            </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
            <DataTemplate>
                <ItemsControl ItemsSource="{Binding}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:FixedWrapPanel ItemsPerLine="{Binding $parent[UserControl].DataContext.ImagesPerLine}"
                                                     AspectRatio="{Binding $parent[UserControl].DataContext.SelectedAspectRatio.AspectRatio}"
                                                     RowHeight="{Binding $parent[UserControl].DataContext.PanelRowHeight, Mode=OneWayToSource}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="domain:GlanceMediaPreviewViewModel">
                            <controls:MediaPreviewCard HorizontalAlignment="Stretch"
                                                       VerticalAlignment="Stretch"
                                                       SelectCommand="{Binding $parent[UserControl].DataContext.SelectPreviewCommand}"
                                                       SelectCommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>
