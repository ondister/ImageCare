<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:viewModels="clr-namespace:ImageCare.UI.Avalonia.ViewModels"
             xmlns:domain="clr-namespace:ImageCare.UI.Avalonia.ViewModels.Domain"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             xmlns:avaloniaProgressRing="clr-namespace:AvaloniaProgressRing;assembly=AvaloniaProgressRing"
             xmlns:localization="clr-namespace:ImageCare.UI.Avalonia.Localization"
             x:Class="ImageCare.UI.Avalonia.Views.FoldersView"
             prism:ViewModelLocator.AutoWireViewModel="True"
             x:DataType="viewModels:FoldersViewModel"
             x:Name="This">

    <Grid Margin="4,2,4,4" RowDefinitions="*,Auto">
        <TreeView x:Name="FolderTree"
                  Grid.Row="0"
                  Background="Transparent"
                  ItemsSource="{Binding FileSystemItemViewModels}"
                  SelectedItem="{Binding SelectedFileSystemItem, Mode=TwoWay}"
                  SelectionMode="Single"
                  IsVisible="{Binding !IsInSearchSession}">
            <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="domain:DirectoryViewModel">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="MinHeight" Value="26" />
                    <Setter Property="Padding" Value="2,0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="CornerRadius" Value="6" />
                </Style>
                <Style Selector="TreeViewItem:selected">
                    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                </Style>
                <Style Selector="TreeViewItem:pointerover:not(:selected)">
                    <Setter Property="Background" Value="{DynamicResource ThemeControlLowBrush}" />
                </Style>
                <Style Selector="Border.FolderRow.Selected">
                    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                </Style>
                <Style Selector="Button.TreeAction">
                    <Setter Property="Width" Value="22" />
                    <Setter Property="Height" Value="22" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="5" />
                    <Setter Property="CornerRadius" Value="5" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </TreeView.Styles>

            <TreeView.DataTemplates>
                <TreeDataTemplate DataType="domain:DeviceViewModel" ItemsSource="{Binding ChildFileSystemItems}">
                    <Grid MinHeight="26" ColumnDefinitions="24,*" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Grid.Column="0"
                                                    Kind="DesktopClassic"
                                                    Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Margin="7,0,4,0"
                                   Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </TreeDataTemplate>

                <TreeDataTemplate DataType="domain:SpecialDirectoryViewModel" ItemsSource="{Binding ChildFileSystemItems}">
                    <Grid MinHeight="28" ColumnDefinitions="20,Auto,Auto" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Grid.Column="0"
                                                    Kind="History"
                                                    Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Margin="4,0,2,0"
                                   Text="{localization:Loc Folders_Recent}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{localization:Loc Folders_RecentHint}" />
                        <Button Grid.Column="2"
                                Classes="TreeAction"
                                Click="OnChoosePopularFolderClick"
                                ToolTip.Tip="{localization:Loc Folders_AddRecent}">
                            <iconPacks:PackIconMaterial Kind="Plus"
                                                        Width="14"
                                                        Height="14" />
                        </Button>
                    </Grid>
                </TreeDataTemplate>

                <TreeDataTemplate DataType="domain:FixedDriveViewModel" ItemsSource="{Binding ChildFileSystemItems}">
                    <Grid MinHeight="26" ColumnDefinitions="24,*" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Grid.Column="0"
                                                    Kind="Harddisk"
                                                    Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Margin="7,0,4,0"
                                   Text="{Binding Name}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </TreeDataTemplate>

                <TreeDataTemplate DataType="domain:NetworkDriveViewModel" ItemsSource="{Binding ChildFileSystemItems}">
                    <Grid MinHeight="26" ColumnDefinitions="24,*" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Grid.Column="0"
                                                    Kind="FolderNetworkOutline"
                                                    Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Margin="7,0,4,0"
                                   Text="{Binding Name}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </TreeDataTemplate>

                <TreeDataTemplate DataType="domain:RemovableDriveViewModel" ItemsSource="{Binding ChildFileSystemItems}">
                    <Grid MinHeight="34" ColumnDefinitions="24,*,Auto" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Grid.Column="0"
                                                    Kind="Sd"
                                                    Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Margin="7,0,8,0"
                                   Text="{Binding Name}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="2"
                                    Width="82"
                                    Margin="4,3,4,3"
                                    Spacing="3"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding SpaceInfo}"
                                       FontSize="{StaticResource Font.Size.Micro}"
                                       HorizontalAlignment="Right" />
                            <ProgressBar Height="3"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding SpacePercentage}" />
                        </StackPanel>
                    </Grid>
                </TreeDataTemplate>

                <TreeDataTemplate x:DataType="domain:DirectoryViewModel" ItemsSource="{Binding ChildFileSystemItems}">
                    <Border Classes="FolderRow"
                            Classes.Selected="{Binding IsSelected}"
                            MinHeight="26"
                            Background="Transparent"
                            CornerRadius="5">
                        <Grid MinHeight="26" ColumnDefinitions="24,*,Auto" VerticalAlignment="Center">
                        <Grid Grid.Column="0" Width="20" Height="20">
                            <iconPacks:PackIconMaterial Kind="FolderOutline"
                                                        Width="18"
                                                        Height="18"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding IsClosedRegularFolder}" />
                            <iconPacks:PackIconMaterial Kind="FolderOpenOutline"
                                                        Width="18"
                                                        Height="18"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding IsOpenFolderIconVisible}" />
                            <iconPacks:PackIconMaterial Kind="FolderImage"
                                                        Width="18"
                                                        Height="18"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding IsClosedMediaFolder}" />
                            <avaloniaProgressRing:ProgressRing Width="18"
                                                               Height="18"
                                                               IsActive="{Binding IsLoading}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding IsLoading}" />
                        </Grid>

                        <ContentPresenter Grid.Column="1"
                                          Content="{Binding}"
                                          Classes.IsEditing="{Binding IsEditing}"
                                          Classes.IsNotEditing="{Binding !IsEditing}"
                                          Margin="7,0,4,0"
                                          VerticalAlignment="Center">
                            <ContentPresenter.KeyBindings>
                                <KeyBinding Command="{Binding RenameFolderCommand}" Gesture="Enter" />
                            </ContentPresenter.KeyBindings>
                            <ContentPresenter.Resources>
                                <DataTemplate x:Key="DisplayTemplate" x:DataType="domain:DirectoryViewModel">
                                    <StackPanel Spacing="0">
                                        <TextBlock Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{localization:Loc Folders_AddRecent}"
                                                              Tag="{Binding}"
                                                              Click="OnAddFolderToRecentClick"
                                                              IsVisible="{Binding !IsRecentEntry}" />
                                                    <Separator IsVisible="{Binding !IsRecentEntry}" />
                                                    <MenuItem Header="{localization:Loc Common_Create}"
                                                              Command="{Binding CreateFolderCommand}"
                                                              IsVisible="{Binding !IsRecentEntry}" />
                                                    <MenuItem Header="{localization:Loc Common_Rename}"
                                                              Command="{Binding StartRenameFolderCommand}"
                                                              IsVisible="{Binding !IsRecentEntry}" />
                                                    <MenuItem Header="{localization:Loc Common_Delete}"
                                                              Command="{Binding DeleteFolderCommand}"
                                                              IsVisible="{Binding !IsRecentEntry}" />
                                                </ContextMenu>
                                            </TextBlock.ContextMenu>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Path}"
                                                   FontSize="{StaticResource Font.Size.Micro}"
                                                   Opacity="0.65"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding IsRecentEntry}" />
                                    </StackPanel>
                                </DataTemplate>
                                <DataTemplate x:Key="EditTemplate" x:DataType="domain:DirectoryViewModel">
                                    <TextBox Text="{Binding EditableName, UpdateSourceTrigger=PropertyChanged}"
                                             LostFocus="OnNameTextBoxLostFocus" />
                                </DataTemplate>
                            </ContentPresenter.Resources>
                            <ContentPresenter.Styles>
                                <Style Selector="ContentPresenter.IsNotEditing">
                                    <Setter Property="ContentTemplate" Value="{StaticResource DisplayTemplate}" />
                                </Style>
                                <Style Selector="ContentPresenter.IsEditing">
                                    <Setter Property="ContentTemplate" Value="{StaticResource EditTemplate}" />
                                </Style>
                            </ContentPresenter.Styles>
                        </ContentPresenter>

                        <Button Grid.Column="2"
                                Classes="TreeAction"
                                Margin="2,0"
                                IsVisible="{Binding IsPinnedPopular}"
                                Command="{Binding DataContext.RemoveRecentFolderCommand, ElementName=This}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="{localization:Loc Folders_RemoveRecent}">
                            <iconPacks:PackIconMaterial Kind="Close"
                                                        Width="13"
                                                        Height="13" />
                        </Button>
                        </Grid>
                    </Border>
                </TreeDataTemplate>
            </TreeView.DataTemplates>
        </TreeView>

        <Border Grid.Row="0"
                Padding="4"
                Background="{DynamicResource ThemeBackgroundBrush}"
                IsVisible="{Binding IsInSearchSession}">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0"
                           Text="{Binding SearchHeader}"
                           FontWeight="SemiBold"
                           Margin="6,4,6,8" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="domain:DirectoryViewModel">
                                <Button Margin="2"
                                        Padding="8,6"
                                        HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.SetSearchResultCommand, ElementName=This}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="{localization:Loc Action_OpenFolder}">
                                    <Grid ColumnDefinitions="24,*">
                                        <iconPacks:PackIconMaterial Grid.Column="0"
                                                                    Kind="FolderSearch"
                                                                    Width="18"
                                                                    Height="18"
                                                                    VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Path}"
                                                       FontSize="{StaticResource Font.Size.Micro}"
                                                       Opacity="0.65"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="0"
                Grid.RowSpan="2"
                Background="{DynamicResource ThemeBackgroundBrush}"
                Opacity="0.92"
                IsVisible="{Binding IsLoading}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <avaloniaProgressRing:ProgressRing Width="48"
                                                   Height="48"
                                                   IsActive="{Binding IsLoading}"
                                                   HorizontalAlignment="Center" />
                <TextBlock MaxWidth="220"
                           Text="{localization:Loc Preview_LoadingFolder}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Height="32"
                Background="{DynamicResource ThemeControlMidBrush}"
                CornerRadius="6"
                Margin="2,4,2,0"
                IsVisible="{Binding IsSearchEnabled}">
            <Grid Height="30" ColumnDefinitions="*,Auto">
                <Grid Grid.Column="0">
                    <TextBox x:Name="SearchTextBox"
                             Height="30"
                             MinHeight="0"
                             Padding="8,0"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             PlaceholderText="{Binding SearchTarget}"
                             IsEnabled="{Binding !IsSearching}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}">
                        <TextBox.KeyBindings>
                            <KeyBinding Command="{Binding PerformSearchCommand}" Gesture="Enter" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Border Background="{DynamicResource ThemeControlMidBrush}"
                            CornerRadius="6"
                            Opacity="0.96"
                            IsVisible="{Binding IsSearching}">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="6">
                            <avaloniaProgressRing:ProgressRing Width="16"
                                                               Height="16"
                                                               IsActive="True" />
                            <TextBlock Text="{localization:Loc Folders_Searching}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Button Grid.Column="1"
                        Classes="TreeAction"
                        Margin="2"
                        Command="{Binding PerformSearchCommand}"
                        ToolTip.Tip="{localization:Loc Folders_SearchFolders}"
                        IsVisible="{Binding !IsInSearchSession}">
                    <iconPacks:PackIconMaterial Kind="FolderSearch" Width="16" Height="16" />
                </Button>
                <Button Grid.Column="1"
                        Classes="TreeAction"
                        Margin="2"
                        Command="{Binding ClearSearchCommand}"
                        ToolTip.Tip="{localization:Loc Action_ClearSearch}"
                        IsVisible="{Binding IsInSearchSession}">
                    <iconPacks:PackIconMaterial Kind="Close" Width="16" Height="16" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
