<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:viewModels="clr-namespace:ImageCare.UI.Avalonia.ViewModels"
             xmlns:domain="clr-namespace:ImageCare.UI.Avalonia.ViewModels.Domain"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             xmlns:avaloniaProgressRing="clr-namespace:AvaloniaProgressRing;assembly=AvaloniaProgressRing"
             xmlns:localization="clr-namespace:ImageCare.UI.Avalonia.Localization"
             x:Class="ImageCare.UI.Avalonia.Views.FoldersView"
             prism:ViewModelLocator.AutoWireViewModel="True"
             x:DataType="viewModels:FoldersViewModel"
             x:Name="This">

    <Grid Margin="{StaticResource MarginAll.Small}">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Folders Panel -->
        <TreeView Grid.Row="0"
                  ItemsSource="{Binding FileSystemItemViewModels}"
                  SelectedItem="{Binding SelectedFileSystemItem, Mode=TwoWay}"
                  SelectionMode="Single"
                  IsVisible="{Binding !IsInSearchSession}">

            <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="domain:DirectoryViewModel">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </Style>
            </TreeView.Styles>

            <TreeView.DataTemplates>

                <TreeDataTemplate DataType="domain:DeviceViewModel" ItemsSource="{Binding ChildFileSystemItems}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="DesktopClassic"
                                                    Height="{StaticResource Icon.Size.Small}"
                                                    Width="{StaticResource Icon.Size.Small}"
                                                    Margin="{StaticResource MarginHorizontal.Small}" />
                        <TextBlock Text="{Binding Name}"
                                   Margin="{StaticResource MarginHorizontal.Small}" />
                    </StackPanel>
                </TreeDataTemplate>

                <TreeDataTemplate DataType="domain:FixedDriveViewModel" ItemsSource="{Binding ChildFileSystemItems}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Harddisk"
                                                    Height="{StaticResource Icon.Size.Small}"
                                                    Width="{StaticResource Icon.Size.Small}"
                                                    Margin="{StaticResource MarginHorizontal.Small}" />
                        <TextBlock Text="{Binding Name}"
                                   Margin="{StaticResource MarginHorizontal.Small}" />
                    </StackPanel>
                </TreeDataTemplate>

                <TreeDataTemplate DataType="domain:NetworkDriveViewModel" ItemsSource="{Binding ChildFileSystemItems}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="FolderNetworkOutline"
                                                    Height="{StaticResource Icon.Size.Small}"
                                                    Width="{StaticResource Icon.Size.Small}"
                                                    Margin="{StaticResource MarginHorizontal.Small}" />
                        <TextBlock Text="{Binding Name}"
                                   Margin="{StaticResource MarginHorizontal.Small}" />
                    </StackPanel>
                </TreeDataTemplate>

                <TreeDataTemplate DataType="domain:RemovableDriveViewModel"
                                  ItemsSource="{Binding ChildFileSystemItems}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Sd"
                                                    Height="{StaticResource Icon.Size.Small}"
                                                    Width="{StaticResource Icon.Size.Small}"
                                                    Margin="{StaticResource MarginHorizontal.Small}" />
                        <TextBlock Text="{Binding Name}"
                                   Margin="{StaticResource MarginHorizontal.Small}" />
                        <StackPanel Orientation="Vertical">
                            <ProgressBar
                                Width="40"
                                Maximum="100"
                                Minimum="0"
                                HorizontalAlignment="Left"
                                Value="{Binding SpacePercentage}" />
                            <TextBlock Text="{Binding SpaceInfo}"
                                       HorizontalAlignment="Right"
                                       FontSize="{StaticResource Font.Size.Small}"
                                       Margin="{StaticResource MarginVertical.Small}" />
                        </StackPanel>
                    </StackPanel>
                </TreeDataTemplate>

                <TreeDataTemplate x:DataType="domain:DirectoryViewModel" ItemsSource="{Binding ChildFileSystemItems}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="FolderOutline"
                                                    Height="{StaticResource Icon.Size.Small}"
                                                    Width="{StaticResource Icon.Size.Small}"
                                                    Margin="{StaticResource MarginHorizontal.Small}">
                            <iconPacks:PackIconMaterial.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="!IsExpanded" />
                                    <Binding Path="!HasSupportedMedia" />
                                </MultiBinding>
                            </iconPacks:PackIconMaterial.IsVisible>
                        </iconPacks:PackIconMaterial>

                        <iconPacks:PackIconMaterial Kind="FolderOpenOutline"
                                                    Height="{StaticResource Icon.Size.Small}"
                                                    Width="{StaticResource Icon.Size.Small}"
                                                    Margin="{StaticResource MarginHorizontal.Small}"
                                                    IsVisible="{Binding IsExpanded}" />

                        <iconPacks:PackIconMaterial Kind="FolderImage"
                                                    Height="{StaticResource Icon.Size.Small}"
                                                    Width="{StaticResource Icon.Size.Small}"
                                                    Margin="{StaticResource MarginHorizontal.Small}">
                            <iconPacks:PackIconMaterial.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="!IsExpanded" />
                                    <Binding Path="HasSupportedMedia" />
                                </MultiBinding>
                            </iconPacks:PackIconMaterial.IsVisible>
                        </iconPacks:PackIconMaterial>

                        <avaloniaProgressRing:ProgressRing Width="{StaticResource Icon.Size.Small}"
                                                           Height="{StaticResource Icon.Size.Small}"
                                                           IsActive="True"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Margin="{StaticResource MarginHorizontal.Small}"
                                                           IsVisible="{Binding IsLoaded}" />
                        <ContentPresenter Content="{Binding}"
                                          Classes.IsEditing="{Binding IsEditing}"
                                          Classes.IsNotEditing="{Binding !IsEditing}"
                                          Margin="{StaticResource MarginHorizontal.Small}">

                            <ContentPresenter.KeyBindings>
                                <KeyBinding Command="{Binding RenameFolderCommand}" Gesture="Enter" />
                            </ContentPresenter.KeyBindings>

                            <ContentPresenter.Resources>
                                <!-- Display Template -->
                                <DataTemplate x:Key="DisplayTemplate"
                                              x:DataType="domain:DirectoryViewModel">
                                    <TextBlock Text="{Binding Name}">
                                        <TextBlock.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{localization:Loc Common_Create}"
                                                          Command="{Binding CreateFolderCommand}" />
                                                <MenuItem Header="{localization:Loc Common_Rename}"
                                                          Command="{Binding StartRenameFolderCommand}" />
                                                <MenuItem Header="{localization:Loc Common_Delete}"
                                                          Command="{Binding DeleteFolderCommand}" />
                                            </ContextMenu>
                                        </TextBlock.ContextMenu>
                                    </TextBlock>
                                </DataTemplate>

                                <!-- Edit Template -->
                                <DataTemplate x:Key="EditTemplate"
                                              x:DataType="domain:DirectoryViewModel">
                                    <TextBox Text="{Binding EditableName, UpdateSourceTrigger=PropertyChanged}"
                                             LostFocus="OnNameTextBoxLostFocus" />
                                </DataTemplate>
                            </ContentPresenter.Resources>

                            <ContentPresenter.Styles>
                                <Style Selector="ContentPresenter.IsNotEditing">
                                    <Setter Property="ContentTemplate" Value="{StaticResource DisplayTemplate}" />
                                </Style>
                                <Style Selector="ContentPresenter.IsEditing">
                                    <Setter Property="ContentTemplate" Value="{StaticResource EditTemplate}" />
                                </Style>
                            </ContentPresenter.Styles>
                        </ContentPresenter>
                    </StackPanel>
                </TreeDataTemplate>
            </TreeView.DataTemplates>
        </TreeView>

        <!-- Search Results Panel -->
        <Border Grid.Row="0"
                Background="{DynamicResource ThemeBackgroundBrush}"
                IsVisible="{Binding IsInSearchSession}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Search Header -->
                <TextBlock Grid.Row="0"
                           Text="{Binding SearchHeader}"
                           FontWeight="Bold"
                           Margin="{StaticResource MarginBottom.Small}" />

                <!-- Search Results List -->
                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding SearchResults}">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="domain:DirectoryViewModel">
                            <StackPanel Orientation="Horizontal"
                                        Margin="{StaticResource MarginVertical.Small}">
                                <Button Margin="{StaticResource MarginAll.Small}"
                                              VerticalAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              Command="{Binding ElementName=This, Path=DataContext.SetSearchResultCommand}"
                                              CommandParameter="{Binding }"
                                              ToolTip.Tip="{localization:Loc Action_OpenFolder}">

                                        <iconPacks:PackIconMaterial Kind="FolderOutline"
                                                                    Height="{StaticResource Icon.Size.Small}"
                                                                    Width="{StaticResource Icon.Size.Small}"
                                                                    Margin="{StaticResource MarginAll.Small}" />

                                </Button>
                                <TextBlock Text="{Binding Name}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Path}"
                                           VerticalAlignment="Center"
                                           FontSize="{StaticResource Font.Size.Small}"
                                           Opacity="0.7"
                                           Margin="20,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>


        <!-- Loading Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="{DynamicResource ThemeBackgroundBrush}"
                Opacity="0.85"
                IsVisible="{Binding IsLoading}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <avaloniaProgressRing:ProgressRing Width="60"
                                                   Height="60"
                                                   IsActive="{Binding IsLoading}"
                                                   HorizontalAlignment="Center" />
                <TextBlock Text="{localization:Loc Preview_LoadingFolder}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Search Panel -->
        <Border Grid.Row="1"
                Height="30"
                Background="{DynamicResource ThemeControlMidBrush}"
                CornerRadius="4"
                Margin="0,0,0,4"
                IsVisible="{Binding IsSearchEnabled}">
            <Grid Height="28" ColumnDefinitions="*,Auto">
                <!-- Search TextBox with Progress Overlay -->
                <Grid Grid.Column="0">
                    <TextBox x:Name="SearchTextBox"
                             Height="28"
                             MinHeight="0"
                             Padding="6,0"
                             VerticalContentAlignment="Center"
                             PlaceholderText="{Binding SearchTarget}"
                             IsEnabled="{Binding !IsSearching}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}">
                        <TextBox.KeyBindings>
                            <KeyBinding Command="{Binding PerformSearchCommand}" Gesture="Enter" />
                        </TextBox.KeyBindings>
                    </TextBox>

                    <Border Background="{DynamicResource ThemeControlMidBrush}"
                            Opacity="0.9"
                            IsVisible="{Binding IsSearching}">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="6">
                            <avaloniaProgressRing:ProgressRing Width="{StaticResource Icon.Size.Small}"
                                                               Height="{StaticResource Icon.Size.Small}"
                                                               IsActive="True" />
                            <TextBlock Text="{localization:Loc Folders_Searching}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource ThemeForegroundBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Button Grid.Column="1"
                        Width="28"
                        Height="28"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="4"
                        Command="{Binding PerformSearchCommand}"
                        ToolTip.Tip="{localization:Loc Folders_SearchFolders}"
                        IsVisible="{Binding !IsInSearchSession}">
                    <iconPacks:PackIconMaterial Kind="FolderSearch"
                                                Height="{StaticResource Icon.Size.Small}"
                                                Width="{StaticResource Icon.Size.Small}" />
                </Button>

                <Button Grid.Column="1"
                        Width="28"
                        Height="28"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="4"
                        Command="{Binding ClearSearchCommand}"
                        ToolTip.Tip="{localization:Loc Action_ClearSearch}"
                        IsVisible="{Binding IsInSearchSession}">
                    <iconPacks:PackIconMaterial Kind="Close"
                                                Height="{StaticResource Icon.Size.Small}"
                                                Width="{StaticResource Icon.Size.Small}" />
                </Button>
            </Grid>
        </Border>

    </Grid>
</UserControl>