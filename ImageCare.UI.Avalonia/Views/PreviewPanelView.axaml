<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:viewModels="clr-namespace:ImageCare.UI.Avalonia.ViewModels"
             xmlns:views="clr-namespace:ImageCare.UI.Avalonia.Views"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             xmlns:localization="clr-namespace:ImageCare.UI.Avalonia.Localization"
             prism:ViewModelLocator.AutoWireViewModel="True"
             x:Class="ImageCare.UI.Avalonia.Views.PreviewPanelView"
             x:DataType="viewModels:PreviewPanelViewModel"
             FontSize="{StaticResource Font.Size.Small}">

    <UserControl.KeyBindings>
        <KeyBinding Command="{Binding Batch.CopyImagePreviewCommand}" Gesture="F5" />
        <KeyBinding Command="{Binding Batch.MoveImagePreviewCommand}" Gesture="F6" />
        <KeyBinding Command="{Binding Batch.DeleteImagePreviewCommand}" Gesture="Delete" />
    </UserControl.KeyBindings>

    <Grid RowDefinitions="Auto,Auto,*"
          Margin="{StaticResource MarginAll.Small}">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
                <views:TimelineView DataContext="{Binding TimelineVm}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Width="32"
                    Height="32"
                    Padding="4"
                    Margin="2,0,0,0"
                    VerticalAlignment="Center"
                    Command="{Binding FolderTags.ApplyFolderTagsCommand}"
                    IsEnabled="{Binding FolderTags.CanApplyFolderTags}"
                    ToolTip.Tip="{localization:Loc FolderTags_ApplyTooltip}">
                <iconPacks:PackIconLucide Kind="Tags" Width="16" Height="16" />
            </Button>
            <Button Grid.Column="2"
                    Width="32"
                    Height="32"
                    Padding="4"
                    Margin="2,0,0,0"
                    VerticalAlignment="Center"
                    Command="{Binding MediaStrip.ToggleSortDirectionCommand}"
                    IsEnabled="{Binding MediaStrip.CanChangeSort}">
                <Grid>
                    <TextBlock Text="↓"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding !MediaStrip.IsSortAscending}" />
                    <TextBlock Text="↑"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding MediaStrip.IsSortAscending}" />
                </Grid>
                <ToolTip.Tip>
                    <Grid>
                        <TextBlock Text="{localization:Loc Sort_NewestFirst}"
                                   IsVisible="{Binding !MediaStrip.IsSortAscending}" />
                        <TextBlock Text="{localization:Loc Sort_OldestFirst}"
                                   IsVisible="{Binding MediaStrip.IsSortAscending}" />
                    </Grid>
                </ToolTip.Tip>
            </Button>
        </Grid>

        <views:PreviewAnnotationEditorView Grid.Row="1"
                                           DataContext="{Binding Annotations}" />

        <views:PreviewSelectionBarView Grid.Row="1"
                                       DataContext="{Binding Batch}" />

        <Grid Grid.Row="2"
              IsEnabled="{Binding !Batch.IsBatchOperationRunning}">
            <TextBlock Text="{localization:Loc Preview_LoadingFolder}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="{StaticResource Font.Size.SectionHeader}"
                       Foreground="{DynamicResource Brush.TextPrimary}"
                       IsVisible="{Binding MediaStrip.FilesLoading}" />

            <views:PreviewStripView x:Name="PreviewStrip"
                                    DataContext="{Binding MediaStrip}" />
        </Grid>
    </Grid>
</UserControl>
