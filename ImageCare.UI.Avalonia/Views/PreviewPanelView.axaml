<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:viewModels="clr-namespace:ImageCare.UI.Avalonia.ViewModels"
             xmlns:domain="clr-namespace:ImageCare.UI.Avalonia.ViewModels.Domain"
             xmlns:controls="clr-namespace:ImageCare.UI.Avalonia.Controls"
             xmlns:behaviors="clr-namespace:ImageCare.UI.Avalonia.Behaviors"
             xmlns:views="clr-namespace:ImageCare.UI.Avalonia.Views"
             xmlns:localization="clr-namespace:ImageCare.UI.Avalonia.Localization"
             prism:ViewModelLocator.AutoWireViewModel="True"
             x:Class="ImageCare.UI.Avalonia.Views.PreviewPanelView"
             x:DataType="viewModels:PreviewPanelViewModel"
             FontSize="{StaticResource Font.Size.Small}">

    <UserControl.KeyBindings>
        <KeyBinding Command="{Binding CopyImagePreviewCommand}" Gesture="F5" />
        <KeyBinding Command="{Binding MoveImagePreviewCommand}" Gesture="F6" />
        <KeyBinding Command="{Binding DeleteImagePreviewCommand}" Gesture="Delete" />
    </UserControl.KeyBindings>

    <Grid RowDefinitions="Auto,Auto,*"
          Margin="{StaticResource MarginAll.Small}">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <views:TimelineView Grid.Column="0"
                                DataContext="{Binding TimelineVm}" />
            <Button Grid.Column="1"
                    Width="32"
                    Height="32"
                    Padding="4"
                    Margin="2,0,0,0"
                    VerticalAlignment="Center"
                    Command="{Binding ToggleSortDirectionCommand}"
                    IsEnabled="{Binding CanChangeSort}">
                <Grid>
                    <TextBlock Text="↓"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding !IsSortAscending}" />
                    <TextBlock Text="↑"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsSortAscending}" />
                </Grid>
                <ToolTip.Tip>
                    <Grid>
                        <TextBlock Text="{localization:Loc Sort_NewestFirst}"
                                   IsVisible="{Binding !IsSortAscending}" />
                        <TextBlock Text="{localization:Loc Sort_OldestFirst}"
                                   IsVisible="{Binding IsSortAscending}" />
                    </Grid>
                </ToolTip.Tip>
            </Button>
        </Grid>

        <Border Grid.Row="1" Margin="2,4" Padding="8,4" CornerRadius="4"
                Background="{DynamicResource Brush.PreviewSurface}"
                IsVisible="{Binding HasAnnotatableSelection}"
                IsEnabled="{Binding CanEditAnnotations}">
            <Grid ColumnDefinitions="Auto,70,Auto,180,Auto,*,Auto" ColumnSpacing="6">
                <TextBlock Grid.Column="0" Text="{localization:Loc Annotations_Rating}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedRating, Mode=TwoWay}" MinWidth="105">
                    <ComboBoxItem Content="{localization:Loc Annotations_Unrated}" />
                    <ComboBoxItem Content="★" />
                    <ComboBoxItem Content="★★" />
                    <ComboBoxItem Content="★★★" />
                    <ComboBoxItem Content="★★★★" />
                    <ComboBoxItem Content="★★★★★" />
                </ComboBox>
                <Button Grid.Column="2" Content="{localization:Loc Common_Save}" Command="{Binding SaveRatingCommand}" />
                <ComboBox Grid.Column="3" ItemsSource="{Binding AvailableAnnotationTags}" Text="{Binding NewTag}"
                          IsEditable="True" />
                <Button Grid.Column="4" Content="{localization:Loc Settings_Add}" Command="{Binding AddTagCommand}" />
                <ItemsControl Grid.Column="5" ItemsSource="{Binding CurrentTags}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="2,0" Padding="5,1"
                                    Content="{Binding}"
                                    Command="{Binding $parent[UserControl].DataContext.RemoveTagCommand}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Column="6" Text="{Binding AnnotationEditorStatus}" Opacity="0.7" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="{localization:Loc Preview_LoadingFolder}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="{StaticResource Font.Size.SectionHeader}"
                   Foreground="{DynamicResource Brush.TextPrimary}"
                   IsVisible="{Binding FilesLoading}" />

        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      behaviors:HorizontalScrollBehavior.IsEnabled="True"
                      behaviors:HorizontalScrollBehavior.IsScrollResetRequested="{Binding IsScrollResetRequested, Mode=TwoWay}">
            <controls:PreviewsListBox ItemsSource="{Binding ImagePreviews}"
                                      SelectedItem="{Binding SelectedPreview, Mode=TwoWay}"
                                      SelectionMode="Single"
                                      ItemContainerTheme="{StaticResource PreviewListBoxItem}"
                                      Padding="0"
                                      BorderThickness="0"
                                      Theme="{StaticResource PreviewsListBox}"
                                      behaviors:PreviewDragDropBehavior.DropHandler="{Binding ImagePreviewDropHandler}"
                                      behaviors:ScrollToIndexBehavior.TargetIndex="{Binding IndexInView, Mode=TwoWay}">
                <controls:PreviewsListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </controls:PreviewsListBox.ItemsPanel>

                <controls:PreviewsListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Margin" Value="{StaticResource MarginHorizontal.Small}" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="VerticalAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="ListBoxItem:selected">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </controls:PreviewsListBox.Styles>

                <controls:PreviewsListBox.ItemTemplate>
                    <DataTemplate DataType="domain:MediaPreviewViewModel">
                        <controls:MediaPreviewCard Width="270"
                                                   Height="300"
                                                   VerticalAlignment="Center" />
                    </DataTemplate>
                </controls:PreviewsListBox.ItemTemplate>
            </controls:PreviewsListBox>
        </ScrollViewer>
    </Grid>
</UserControl>
