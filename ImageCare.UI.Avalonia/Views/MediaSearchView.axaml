<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:ImageCare.UI.Avalonia.ViewModels"
             xmlns:domain="clr-namespace:ImageCare.UI.Avalonia.ViewModels.Domain"
             xmlns:localization="clr-namespace:ImageCare.UI.Avalonia.Localization"
             x:Class="ImageCare.UI.Avalonia.Views.MediaSearchView"
             x:DataType="viewModels:MediaSearchViewModel">
    <Grid Margin="16" RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <!-- Filter form: label column, input column and a fixed action column keep every row aligned. -->
        <Grid Grid.Row="0"
              RowDefinitions="Auto,Auto,Auto"
              ColumnDefinitions="Auto,*,160"
              ColumnSpacing="8"
              RowSpacing="8"
              x:CompileBindings="True">
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{localization:Loc Search_File}"
                       VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{Binding Text}"
                     PlaceholderText="{localization:Loc Search_TextPlaceholder}" />
            <Button Grid.Row="0" Grid.Column="2"
                    Content="{localization:Loc Search_Search}"
                    Command="{Binding SearchCommand}"
                    HorizontalAlignment="Stretch" />

            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="{localization:Loc Search_Tags}"
                       VerticalAlignment="Top" />
            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                <TextBox x:Name="TagInput"
                         Text="{Binding TagSearchText, Mode=TwoWay}"
                         PlaceholderText="{localization:Loc Search_TagsPlaceholder}"
                         KeyDown="OnTagInputKeyDown" />
                <ItemsControl ItemsSource="{Binding SelectedTags}"
                              IsVisible="{Binding HasSelectedTags}"
                              x:CompileBindings="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,6,0"
                                    Padding="8,2"
                                    CornerRadius="12"
                                    Background="{DynamicResource Brush.AccentSubtle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding}"
                                               VerticalAlignment="Center" />
                                    <Button Classes="IconButton"
                                            Content="✕"
                                            Width="16"
                                            Height="16"
                                            MinWidth="16"
                                            MinHeight="16"
                                            Padding="0"
                                            FontSize="10"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="{localization:Loc Search_RemoveTag}"
                                            Command="{Binding $parent[UserControl].DataContext.RemoveTagCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{localization:Loc Search_AvailableTags}"
                           FontSize="11"
                           Opacity="0.6"
                           IsVisible="{Binding HasAvailableTags}" />
                <ScrollViewer MaxHeight="78"
                              VerticalScrollBarVisibility="Auto"
                              IsVisible="{Binding HasAvailableTags}">
                    <ItemsControl ItemsSource="{Binding TagSuggestions}"
                                  IsVisible="{Binding HasTagSuggestions}"
                                  x:CompileBindings="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,4,4"
                                        Padding="8,0"
                                        FontSize="11"
                                        Height="22"
                                        MinHeight="22"
                                        MinWidth="0"
                                        VerticalContentAlignment="Center"
                                        Content="{Binding}"
                                        Command="{Binding $parent[UserControl].DataContext.AddTagCommand}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="{localization:Loc Search_NoMatchingTags}"
                           FontSize="11"
                           Opacity="0.6"
                           IsVisible="{Binding NoMatchingTags}" />
            </StackPanel>
            <ComboBox Grid.Row="1" Grid.Column="2"
                      SelectedIndex="{Binding TagMatchModeIndex, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Top">
                <ComboBoxItem Content="{localization:Loc Search_AllTags}" />
                <ComboBoxItem Content="{localization:Loc Search_AnyTag}" />
            </ComboBox>

            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="{localization:Loc Search_Rating}"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Row="2" Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <TextBlock Text="{localization:Loc Search_RatingFrom}"
                           Opacity="0.75"
                           VerticalAlignment="Center" />
                <ComboBox Width="120" SelectedIndex="{Binding MinimumRatingIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{localization:Loc Search_AnyRating}" />
                    <ComboBoxItem Content="★" />
                    <ComboBoxItem Content="★★" />
                    <ComboBoxItem Content="★★★" />
                    <ComboBoxItem Content="★★★★" />
                    <ComboBoxItem Content="★★★★★" />
                </ComboBox>
                <TextBlock Text="{localization:Loc Search_RatingTo}"
                           Opacity="0.75"
                           VerticalAlignment="Center" />
                <ComboBox Width="120" SelectedIndex="{Binding MaximumRatingIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{localization:Loc Search_AnyRating}" />
                    <ComboBoxItem Content="★" />
                    <ComboBoxItem Content="★★" />
                    <ComboBoxItem Content="★★★" />
                    <ComboBoxItem Content="★★★★" />
                    <ComboBoxItem Content="★★★★★" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusText}"
                   Opacity="0.75"
                   TextWrapping="Wrap"
                   x:CompileBindings="True" />

        <Grid Grid.Row="2" RowDefinitions="*,Auto" RowSpacing="8">
            <DataGrid x:Name="ResultsGrid"
                      Grid.Row="0"
                      ItemsSource="{Binding Results}"
                      SelectedItem="{Binding SelectedResult}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      CanUserResizeColumns="True"
                      RowHeight="80">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{localization:Loc Search_Preview}"
                                            Width="118"
                                            MinWidth="84"
                                            MaxWidth="260"
                                            CanUserResize="True"
                                            CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="domain:MediaSearchResultViewModel">
                                <Border Height="64"
                                        CornerRadius="4"
                                        ClipToBounds="True"
                                        HorizontalAlignment="Stretch"
                                        Background="{DynamicResource Brush.PreviewSurface}">
                                    <Image Source="{Binding Thumbnail}"
                                           Stretch="UniformToFill"
                                           x:CompileBindings="True" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{localization:Loc Search_File}"
                                        Binding="{Binding FileName}"
                                        Width="180"
                                        MinWidth="90" />
                    <DataGridTemplateColumn Header="{localization:Loc Search_Rating}"
                                            Width="140"
                                            MinWidth="110"
                                            SortMemberPath="Rating">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="domain:MediaSearchResultViewModel">
                                <TextBlock Text="{Binding RatingStars}"
                                           FontSize="18"
                                           Foreground="{DynamicResource Brush.Accent}"
                                           VerticalAlignment="Center"
                                           x:CompileBindings="True" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{localization:Loc Search_Tags}"
                                        Binding="{Binding TagSummary}"
                                        Width="160"
                                        MinWidth="80" />
                    <DataGridTextColumn Header="{localization:Loc Search_Path}"
                                        Binding="{Binding Path}"
                                        Width="*"
                                        MinWidth="120" />
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right"
                        x:CompileBindings="True">
                <Button Content="{localization:Loc Search_ShowSelected}"
                        Command="{Binding ShowSelectedCommand}"
                        MinWidth="120" />
                <Button Content="{localization:Loc Search_OpenSelected}"
                        Command="{Binding OpenSelectedCommand}"
                        MinWidth="120" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
