<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ImageCare.UI.Avalonia.Controls"
             xmlns:views="clr-namespace:ImageCare.UI.Avalonia.Views"
             xmlns:preview="clr-namespace:ImageCare.UI.Avalonia.ViewModels.Preview"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             xmlns:localization="clr-namespace:ImageCare.UI.Avalonia.Localization"
             x:Class="ImageCare.UI.Avalonia.Views.PreviewAnnotationEditorView"
             x:DataType="preview:PreviewAnnotationEditorViewModel"
             FontSize="{StaticResource Font.Size.Small}">

    <UserControl.Styles>
        <Style Selector="Button.tagRemoveButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="MinWidth" Value="14" />
            <Setter Property="MinHeight" Value="14" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Styles>

    <Border Margin="2,3" Padding="8,4" CornerRadius="4"
            Background="{DynamicResource Brush.PreviewSurface}"
            IsVisible="{Binding HasAnnotatableSelection}"
            ToolTip.Tip="{Binding AnnotationEditorStatus}">
        <Grid ColumnDefinitions="*,Auto">
            <ScrollViewer Grid.Column="0"
                          IsEnabled="{Binding CanEditAnnotations}"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <controls:RatingControl Rating="{Binding SelectedRating, Mode=TwoWay}"
                                            Width="150"
                                            Height="22"
                                            MinHeight="22"
                                            VerticalAlignment="Center" />
                    <TextBox x:Name="PreviewTagInput"
                             Width="150"
                             Height="22"
                             MinHeight="22"
                             Padding="6,0"
                             FontSize="12"
                             VerticalContentAlignment="Center"
                             Text="{Binding NewTag, Mode=TwoWay}"
                             PlaceholderText="{localization:Loc Search_TagsPlaceholder}"
                             KeyDown="OnPreviewTagInputKeyDown" />
                    <Popup Name="TagSuggestionsPopup"
                           PlacementTarget="{Binding #PreviewTagInput}"
                           Placement="Top"
                           IsLightDismissEnabled="True"
                           HorizontalOffset="0"
                           VerticalOffset="-4">
                        <Border Background="{DynamicResource Brush.PreviewCard}"
                                BorderBrush="{DynamicResource Brush.Splitter}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Opacity="1"
                                Padding="6">
                            <ScrollViewer MaxHeight="180"
                                          Width="260"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding AvailableAnnotationTags}"
                                              x:CompileBindings="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,4,4"
                                                    Padding="8,0"
                                                    FontSize="11"
                                                    Height="22"
                                                    MinHeight="22"
                                                    MinWidth="0"
                                                    VerticalContentAlignment="Center"
                                                    Content="{Binding}"
                                                    Click="OnTagSuggestionClick" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                    <Button Classes="IconButton"
                            Width="22"
                            Height="22"
                            MinWidth="22"
                            MinHeight="22"
                            Padding="4"
                            Command="{Binding AddTagCommand}"
                            ToolTip.Tip="{localization:Loc Settings_Add}">
                        <iconPacks:PackIconLucide Kind="Tag" Width="14" Height="14" />
                    </Button>
                    <ItemsControl ItemsSource="{Binding CurrentTags}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ThemeBackgroundBrush}"
                                        CornerRadius="12"
                                        Padding="8,2"
                                        Margin="0,1,4,1">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                        <Button Classes="tagRemoveButton"
                                                Command="{Binding $parent[UserControl].DataContext.RemoveTagCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{localization:Loc Search_RemoveTag}">
                                            <iconPacks:PackIconLucide Kind="X" Width="10" Height="10" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock MaxWidth="160"
                               Text="{Binding AnnotationEditorStatus}"
                               Opacity="0.7"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>
            </ScrollViewer>
            <Button Grid.Column="1"
                    Height="26"
                    MinHeight="26"
                    Padding="8,0"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Command="{Binding $parent[views:PreviewPanelView].DataContext.Batch.ExportSelectionCommand}"
                    IsEnabled="{Binding $parent[views:PreviewPanelView].DataContext.Batch.CanExportSelection}"
                    ToolTip.Tip="{localization:Loc Batch_ExportJpegTooltip}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <iconPacks:PackIconLucide Kind="Download" Width="14" Height="14" />
                    <TextBlock Text="{localization:Loc Batch_ExportJpegShort}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
