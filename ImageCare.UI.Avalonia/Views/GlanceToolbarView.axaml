<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:ImageCare.UI.Avalonia.Views"
             xmlns:viewModels="clr-namespace:ImageCare.UI.Avalonia.ViewModels"
             xmlns:localization="clr-namespace:ImageCare.UI.Avalonia.Localization"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             x:Class="ImageCare.UI.Avalonia.Views.GlanceToolbarView"
             x:DataType="viewModels:GlancePanelViewModel">

    <Grid ColumnDefinitions="*,Auto">
        <views:TimelineView Grid.Column="0"
                            DataContext="{Binding TimelineVm}" />
        <Button Grid.Column="1"
                Width="32"
                Height="32"
                Padding="4"
                Margin="2,0,0,0"
                VerticalAlignment="Center"
                Command="{Binding PreviewGrid.ToggleSortDirectionCommand}"
                IsEnabled="{Binding PreviewGrid.CanChangeSort}">
            <Grid>
                <TextBlock Text="↓"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsVisible="{Binding !PreviewGrid.IsSortAscending}" />
                <TextBlock Text="↑"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsVisible="{Binding PreviewGrid.IsSortAscending}" />
            </Grid>
            <ToolTip.Tip>
                <Grid>
                    <TextBlock Text="{localization:Loc Sort_NewestFirst}"
                               IsVisible="{Binding !PreviewGrid.IsSortAscending}" />
                    <TextBlock Text="{localization:Loc Sort_OldestFirst}"
                               IsVisible="{Binding PreviewGrid.IsSortAscending}" />
                </Grid>
            </ToolTip.Tip>
        </Button>
    </Grid>
</UserControl>
