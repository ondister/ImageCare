<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ImageCare.UI.Avalonia.Behaviors"
             xmlns:domain="clr-namespace:ImageCare.UI.Avalonia.ViewModels.Domain"
             xmlns:avaloniaProgressRing="clr-namespace:AvaloniaProgressRing;assembly=AvaloniaProgressRing"
             xmlns:viewModels="clr-namespace:ImageCare.UI.Avalonia.ViewModels"
             x:Class="ImageCare.UI.Avalonia.Views.TimelineView"
             x:DataType="viewModels:TimelineViewModel">
    <Grid ColumnDefinitions="Auto,*">
        <avaloniaProgressRing:ProgressRing Grid.Column="0"
                                           IsVisible="{Binding IsLoading}"
                                           IsActive="{Binding IsLoading}"
                                           Width="50"
                                           Height="50"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Accent}" />
        <Button Grid.Column="0"
                Background="{DynamicResource Brush.Accent}"
                CornerRadius="{StaticResource BorderRadius.Small}"
                Padding="{StaticResource Padding.Inner}"
                Margin="{StaticResource MarginAll.ExtraLarge}"
                MinWidth="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding TotalFilesCount}"
                Content="{Binding TotalFilesCount}"
                FontSize="{StaticResource Font.Size.Small}"
                Foreground="White"
                Command="{Binding StatisticsClickCommand}" />

        <ScrollViewer Grid.Column="1"
                      HorizontalScrollBarVisibility="Visible"
                      VerticalScrollBarVisibility="Disabled"
                      AllowAutoHide="True"
                      Background="Transparent"
                      behaviors:WheelScrollBehaviour.IsEnabled="True">
            <ScrollViewer.Styles>
                <Style Selector="ScrollViewer">
                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Visible" />
                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                </Style>
                <Style Selector="ScrollViewer > ScrollBar:horizontal">
                    <Setter Property="Height" Value="10" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Margin" Value="0,0,0,-10" />
                </Style>
            </ScrollViewer.Styles>
            <ItemsControl ItemsSource="{Binding DateStatViewModels}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="domain:DateStatViewModel">
                        <Button Command="{Binding ColumnClickCommand}"
                                CommandParameter="{Binding}"
                                MinHeight="10"
                                Margin="0,0,0,1"
                                Width="38"
                                Padding="0"
                                Background="Transparent"
                                Cursor="Hand">
                            <Button.Styles>
                                <Style Selector="Button /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                                </Style>
                            </Button.Styles>
                            <Grid Height="40">
                                <Rectangle Fill="{DynamicResource Brush.Accent}"
                                           VerticalAlignment="Bottom"
                                           Height="{Binding NormalizedHeight}"
                                           Width="36" />
                                <TextBlock Text="{Binding DisplayText}"
                                           VerticalAlignment="Bottom"
                                           HorizontalAlignment="Center"
                                           Margin="0,-10,0,0"
                                           FontSize="{StaticResource Font.Size.Small}"
                                           Foreground="{DynamicResource Brush.TextPrimary}" />
                            </Grid>
                            <ToolTip.Tip>
                                <StackPanel>
                                    <TextBlock Text="{Binding Date, StringFormat='{}{0:dd MMMM yyyy}'}" />
                                    <TextBlock Text="{Binding Count}" />
                                </StackPanel>
                            </ToolTip.Tip>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
