<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ImageCare.UI.Avalonia.Behaviors"
             xmlns:domain="clr-namespace:ImageCare.UI.Avalonia.ViewModels.Domain"
             xmlns:avaloniaProgressRing="clr-namespace:AvaloniaProgressRing;assembly=AvaloniaProgressRing"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             xmlns:localization="clr-namespace:ImageCare.UI.Avalonia.Localization"
             xmlns:viewModels="clr-namespace:ImageCare.UI.Avalonia.ViewModels"
             x:Class="ImageCare.UI.Avalonia.Views.TimelineView"
             x:DataType="viewModels:TimelineViewModel">
    <Grid MinHeight="32">
        <Button Width="32"
                Height="32"
                Padding="6"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                IsVisible="{Binding !IsExpanded}"
                Command="{Binding ToggleExpandedCommand}"
                ToolTip.Tip="{localization:Loc Timeline_Show}">
            <iconPacks:PackIconLucide Kind="PanelTopOpen" />
        </Button>

        <Grid ColumnDefinitions="72,*,36"
              Height="50"
              IsVisible="{Binding IsExpanded}">
            <Grid Grid.Column="0"
                  Width="64"
                  Height="44"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <avaloniaProgressRing:ProgressRing IsVisible="{Binding IsLoading}"
                                                   IsActive="{Binding IsLoading}"
                                                   Width="28"
                                                   Height="28"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.Accent}" />
                <TextBlock IsVisible="{Binding IsLoading}"
                           Text="{Binding AnalysisProgressText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="8"
                           Foreground="{DynamicResource Brush.TextPrimary}" />
                <Button Background="{DynamicResource Brush.Accent}"
                        CornerRadius="{StaticResource BorderRadius.Small}"
                        Padding="8,4"
                        MinWidth="44"
                        MinHeight="30"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        IsVisible="{Binding TotalFilesCount}"
                        Content="{Binding TotalFilesCount}"
                        FontSize="{StaticResource Font.Size.Small}"
                        Foreground="White"
                        Command="{Binding StatisticsClickCommand}">
                    <ToolTip.Tip>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{localization:Loc Timeline_OpenOverview}" />
                            <TextBlock Text="·" />
                            <TextBlock Text="{Binding TotalFilesCount}" />
                        </StackPanel>
                    </ToolTip.Tip>
                </Button>
            </Grid>

            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          Background="Transparent"
                          behaviors:WheelScrollBehaviour.IsEnabled="True">
                <ItemsControl ItemsSource="{Binding DateStatViewModels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="domain:DateStatViewModel">
                            <Grid ColumnDefinitions="Auto,Auto">
                                <Rectangle Grid.Column="0"
                                           Width="2"
                                           Margin="5,4"
                                           Fill="{DynamicResource Brush.Accent}"
                                           Opacity="0.55"
                                           IsVisible="{Binding IsLastInMonthYear}" />
                                <Button Grid.Column="1"
                                        Command="{Binding ColumnClickCommand}"
                                        CommandParameter="{Binding}"
                                        Margin="0"
                                        Width="38"
                                        Height="46"
                                        Padding="0"
                                        Background="Transparent"
                                        Cursor="Hand">
                                    <Button.Styles>
                                        <Style Selector="Button /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                                        </Style>
                                    </Button.Styles>
                                    <Grid RowDefinitions="*,Auto">
                                        <Rectangle Grid.Row="0"
                                                   Fill="{DynamicResource Brush.Accent}"
                                                   VerticalAlignment="Bottom"
                                                   Height="{Binding NormalizedHeight}"
                                                   Width="34" />
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding DisplayText}"
                                                   HorizontalAlignment="Center"
                                                   FontSize="{StaticResource Font.Size.Small}"
                                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                                    </Grid>
                                    <ToolTip.Tip>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Date, StringFormat='{}{0:dd MMMM yyyy}'}" />
                                            <TextBlock Text="{Binding Count}" />
                                        </StackPanel>
                                    </ToolTip.Tip>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button Grid.Column="2"
                    Width="28"
                    Height="28"
                    Padding="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Command="{Binding ToggleExpandedCommand}"
                    ToolTip.Tip="{localization:Loc Timeline_Hide}">
                <iconPacks:PackIconLucide Kind="PanelTopClose" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
