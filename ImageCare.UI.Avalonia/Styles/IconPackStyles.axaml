<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia">
    <Styles.Resources>
        <ControlTheme x:Key="ImageCare.PackIconTheme"
                      TargetType="iconPacks:PackIconControlBase">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Viewbox>
                            <Path Data="{TemplateBinding Data}"
                                  Fill="{TemplateBinding Foreground}"
                                  Stretch="Uniform" />
                        </Viewbox>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

    <Style Selector="iconPacks|PackIconLucide">
        <Setter Property="Theme" Value="{StaticResource ImageCare.PackIconTheme}" />
    </Style>

    <Style Selector="iconPacks|PackIconMaterial">
        <Setter Property="Theme" Value="{StaticResource ImageCare.PackIconTheme}" />
    </Style>
</Styles>
