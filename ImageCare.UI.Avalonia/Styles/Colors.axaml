<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="Brush.Accent" Color="#0067C0" />
            <SolidColorBrush x:Key="Brush.AccentHover" Color="#1975C5" />
            <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#E6F2FA" />
            <SolidColorBrush x:Key="Brush.Danger" Color="#C42B1C" />
            <SolidColorBrush x:Key="Brush.DangerHover" Color="#A4262C" />
            <SolidColorBrush x:Key="Brush.Success" Color="#0F7B0F" />
            <SolidColorBrush x:Key="Brush.Warning" Color="#9D5D00" />
            <SolidColorBrush x:Key="Brush.Splitter" Color="#D1D1D1" />
            <SolidColorBrush x:Key="Brush.TextPrimary" Color="#1A1A1A" />
            <SolidColorBrush x:Key="Brush.PreviewCard" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Brush.PreviewSurface" Color="#F0F1F2" />
            <SolidColorBrush x:Key="Brush.PreviewOverlay" Color="#E8FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="Brush.Accent" Color="#60CDFF" />
            <SolidColorBrush x:Key="Brush.AccentHover" Color="#75D5FF" />
            <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#1C3A4A" />
            <SolidColorBrush x:Key="Brush.Danger" Color="#FF99A4" />
            <SolidColorBrush x:Key="Brush.DangerHover" Color="#FFB3BC" />
            <SolidColorBrush x:Key="Brush.Success" Color="#6CCB5F" />
            <SolidColorBrush x:Key="Brush.Warning" Color="#FCE100" />
            <SolidColorBrush x:Key="Brush.Splitter" Color="#454545" />
            <SolidColorBrush x:Key="Brush.TextPrimary" Color="#F5F5F5" />
            <SolidColorBrush x:Key="Brush.PreviewCard" Color="#242424" />
            <SolidColorBrush x:Key="Brush.PreviewSurface" Color="#171717" />
            <SolidColorBrush x:Key="Brush.PreviewOverlay" Color="#E82A2A2A" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
