<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsAotCompatible>True</IsAotCompatible>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Quamotion.TurboJpegWrapper" Version="2.0.32" />
	</ItemGroup>

	<!-- Windows native LibRaw -->
	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
		<None Update="libraw.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<!-- macOS (Apple Silicon) native LibRaw and its vendored dependencies.
	     These are copied next to the managed assembly so the DllImport resolver
	     and the @loader_path install names can find them at runtime. We expose
	     them via a transitive-copy target below so that every project referencing
	     LibRawDotNet (app, tests) also gets the dylibs in its own output.
	     The item set is skipped for the Windows runtime so the win-x64 bundle
	     stays free of macOS binaries. When no RuntimeIdentifier is set (e.g. a
	     plain local build) the glob is still collected; the files only exist for
	     osx-arm64, so on other hosts this is harmless, and it keeps the dylibs
	     flowing on macOS even though RuntimeIdentifier is not propagated into the
	     GetCopyToOutputDirectoryItems sub-build of a referenced project. -->
	<ItemGroup Condition="'$(RuntimeIdentifier)' != 'win-x64'">
		<_LibRawNativeOsxArm64 Include="$(MSBuildProjectDirectory)/runtimes/osx-arm64/native/*.dylib" />
		<None Include="@(_LibRawNativeOsxArm64)">
			<Link>%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<!-- Make the macOS native dylibs flow transitively to referencing projects.
	     Plain <None> items are not copied into a consumer's output, so we add
	     them to the consumer's CopyToOutputDirectory item set explicitly. -->
	<Target Name="IncludeLibRawNativeInTransitiveOutput"
	        Condition="'$(RuntimeIdentifier)' != 'win-x64'"
	        BeforeTargets="GetCopyToOutputDirectoryItems"
	        DependsOnTargets="AssignTargetPaths">
		<ItemGroup>
			<AllItemsFullPathWithTargetPath Include="@(_LibRawNativeOsxArm64->'%(FullPath)')">
				<TargetPath>%(Filename)%(Extension)</TargetPath>
				<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			</AllItemsFullPathWithTargetPath>
		</ItemGroup>
	</Target>

</Project>
